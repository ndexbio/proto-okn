[{"CXVersion":"2.0","hasFragments":false},{"metaData":[{"name":"networkAttributes","elementCount":1},{"name":"visualProperties","elementCount":1},{"name":"visualEditorProperties","elementCount":1},{"name":"attributeDeclarations","elementCount":1},{"name":"nodes","elementCount":9},{"name":"edges","elementCount":27}]},{"attributeDeclarations":[{"nodes":{"represents":{"a":"r","d":"string"},"name":{"a":"n","d":"string"},"alias":{"d":"list_of_string"},"type":{"d":"string"}},"networkAttributes":{"reference":{"d":"string"},"name":{"d":"string"},"description":{"d":"string"},"version":{"d":"string"},"@context":{"d":"string"}},"edges":{"Relationships":{"d":"string"},"__relationship_score":{"d":"double"},"interaction":{"a":"i","d":"string"},"__directed":{"d":"boolean"},"__reverse_directed":{"d":"boolean"},"__edge_source":{"d":"string"}}}]},{"networkAttributes":[{"name":"EGFR-dependent Endothelin signaling events (v2.0)","description":"<p>This is the updated version of an original NCI Pathway Interaction Database (PID) network.</p><p>The list of entities (genes, proteins, chemicals, etc) from the original network was used to query the <a href=\"https://www.indra.bio\" target=\"_blank\"><b>INDRA</b></a> database, retrieving high-quality relationships between entities. INDRA is a database that integrates information from multiple high-quality text mining engines, pathway databases, and small molecule resources. The INDRA-derived relationships are up-to-date and have links to detailed summaries of supporting literature evidence, including the specific supporting text.</p><p>While we have included only high-confidence relationships, text-mining complicated sentences can produce errors such as the reversal of up-regulation vs. down-regulation or the direction of an edge (i.e. B activates A instead of A activates B). Nevertheless, the entity recognition by the text miners is excellent and the text supporting a relationship almost always describes a genuine relationship between the entities.</p><p><b>Legend:</b><br/>BLUE: edges annotated by INDRA only.<br/>RED: edges annotated both by INDRA and PID.<br/>YELLOW: selected element.</p>","version":"2.0 (20220901)","reference":"<p>Pillich RT, Chen J, Churas C, Fong D, Gyori BM, Ideker T, Karis K, Liu SN, Ono K, Pico A, Pratt D.<br/><b>NDEx IQuery: a multi-method network gene set analysis leveraging the Network Data Exchange</b>.<br/> Bioinformatics. 2023 Mar 1;39(3):btad118.<br/><a href=\"https://doi/org/10.1093/bioinformatics/btad118\">doi: 10.1093/bioinformatics/btad118</a></p>","@context":"{\"chebi\": \"https://identifiers.org/chebi/CHEBI:\", \"uniprot\": \"https://identifiers.org/uniprot/\", \"cas\": \"https://identifiers.org/cas/\", \"hgnc.symbol\": \"https://identifiers.org/hgnc.symbol/\"}"}]},{"nodes":[{"id":1,"x":1260,"y":1050,"v":{"n":"EGFR","r":"uniprot:O00688","type":"protein","alias":["uniprot:O00732","uniprot:P00533","uniprot:P06268","uniprot:Q14225","uniprot:Q68GS5","uniprot:Q92795","uniprot:Q9BZS2","uniprot:Q9GZX1","uniprot:Q9H2C9","uniprot:Q9H3C9","uniprot:Q9UMD7","uniprot:Q9UMD8","uniprot:Q9UMG5"]}},{"id":2,"x":1120,"y":1260,"v":{"n":"EGF","r":"uniprot:B4DRK7","type":"protein","alias":["uniprot:E7EVD2","uniprot:E9PBF0","uniprot:P01133","uniprot:Q52LZ6"]}},{"id":3,"x":1260,"y":1400,"v":{"n":"EDN1","r":"uniprot:P05305","type":"protein","alias":["uniprot:Q96DA1"]}},{"id":4,"x":1260,"y":1190,"v":{"n":"EDNRA","r":"uniprot:B2R723","type":"protein","alias":["uniprot:B4E2V6","uniprot:B7Z9G6","uniprot:D3DP03","uniprot:E7ER36","uniprot:O43441","uniprot:P25101","uniprot:Q16432","uniprot:Q16433","uniprot:Q8TBH2"]}},{"id":5,"x":980,"y":980,"v":{"n":"GRB2","r":"uniprot:P29354","type":"protein","alias":["uniprot:P62993","uniprot:Q14450","uniprot:Q63057","uniprot:Q63059"]}},{"id":6,"x":980,"y":1190,"v":{"n":"HRAS","r":"uniprot:B5BUA0","type":"protein","alias":["uniprot:P01112","uniprot:Q14080","uniprot:Q6FHV9","uniprot:Q9BR65","uniprot:Q9UCE2"]}},{"id":7,"x":1050,"y":1400,"v":{"n":"MTOR","r":"unipro