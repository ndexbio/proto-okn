nts?subject=SRC&object=JUN&type=Phosphorylation&format=html&expand_all=true\" target=\"INDRA_Evidence\">6</a>)<li/>SRC increases the amount of JUN(<a href=\"https://db.indra.bio/statements/from_agents?subject=SRC&object=JUN&type=IncreaseAmount&format=html&expand_all=true\" target=\"INDRA_Evidence\">2</a>)<li/>JUN activates SRC(<a href=\"https://db.indra.bio/statements/from_agents?subject=JUN&object=SRC&type=Activation&format=html&expand_all=true\" target=\"INDRA_Evidence\">2</a>)<li/>JUN decreases the amount of SRC(<a href=\"https://db.indra.bio/statements/from_agents?subject=JUN&object=SRC&type=DecreaseAmount&format=html&expand_all=true\" target=\"INDRA_Evidence\">2</a>)</ul>","__relationship_score":3.091042453358316,"i":"interacts with"}},{"id":359,"s":22,"t":34,"v":{"Relationships":"All Evidences (<a href=\"https://db.indra.bio/statements/from_agents?agent0=PTK2&agent1=SRC&format=html&expand_all=false\" target=\"INDRA_Evidence\">2942</a>)<ul><li/>SRC binds PTK2(<a href=\"https://db.indra.bio/statements/from_agents?subject=SRC&object=PTK2&type=Complex&format=html&expand_all=true\" target=\"INDRA_Evidence\">1563</a>)<li/>SRC phosphorylates PTK2(<a href=\"https://db.indra.bio/statements/from_agents?subject=SRC&object=PTK2&type=Phosphorylation&format=html&expand_all=true\" target=\"INDRA_Evidence\">810</a>)<li/>SRC activates PTK2(<a href=\"https://db.indra.bio/statements/from_agents?subject=SRC&object=PTK2&type=Activation&format=html&expand_all=true\" target=\"INDRA_Evidence\">218</a>)<li/>SRC inhibits PTK2(<a href=\"https://db.indra.bio/statements/from_agents?subject=SRC&object=PTK2&type=Inhibition&format=html&expand_all=true\" target=\"INDRA_Evidence\">35</a>)<li/>SRC decreases the amount of PTK2(<a href=\"https://db.indra.bio/statements/from_agents?subject=SRC&object=PTK2&type=DecreaseAmount&format=html&expand_all=true\" target=\"INDRA_Evidence\">16</a>)<li/>SRC dephosphorylates PTK2(<a href=\"https://db.indra.bio/statements/from_agents?subject=SRC&object=PTK2&typ