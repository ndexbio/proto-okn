[{"CXVersion":"2.0","hasFragments":false},{"metaData":[{"name":"networkAttributes","elementCount":1},{"name":"visualProperties","elementCount":1},{"name":"visualEditorProperties","elementCount":1},{"name":"attributeDeclarations","elementCount":1},{"name":"nodes","elementCount":19},{"name":"edges","elementCount":80}]},{"attributeDeclarations":[{"nodes":{"represents":{"a":"r","d":"string"},"name":{"a":"n","d":"string"},"alias":{"d":"list_of_string"},"type":{"d":"string"}},"networkAttributes":{"reference":{"d":"string"},"name":{"d":"string"},"description":{"d":"string"},"version":{"d":"string"},"@context":{"d":"string"}},"edges":{"Relationships":{"d":"string"},"__relationship_score":{"d":"double"},"interaction":{"a":"i","d":"string"},"__directed":{"v":false,"d":"boolean"},"__reverse_directed":{"d":"boolean"},"__edge_source":{"d":"string"}}}]},{"networkAttributes":[{"name":"Hypoxic and oxygen homeostasis regulation of HIF-1-alpha (v2.0)","description":"<p>This is the updated version of an original NCI Pathway Interaction Database (PID) network.</p><p>The list of entities (genes, proteins, chemicals, etc) from the original network was used to query the <a href=\"https://www.indra.bio\" target=\"_blank\"><b>INDRA</b></a> database, retrieving high-quality relationships between entities. INDRA is a database that integrates information from multiple high-quality text mining engines, pathway databases, and small molecule resources. The INDRA-derived relationships are up-to-date and have links to detailed summaries of supporting literature evidence, including the specific supporting text.</p><p>While we have included only high-confidence relationships, text-mining complicated sentences can produce errors such as the reversal of up-regulation vs. down-regulation or the direction of an edge (i.e. B activates A instead of A activates B). Nevertheless, the entity recognition by the text miners is excellent and the text supporting a relationship almost always describes a genuine relationship between the entities.</p><p><b>Legend:</b><br/>BLUE: edges annotated by INDRA only.<br/>RED: edges annotated both by INDRA and PID.<br/>YELLOW: selected element.</p>","version":"2.0 (20220901)","reference":"<p>Pillich RT, Chen J, Churas C, Fong D, Gyori BM, Ideker T, Karis K, Liu SN, Ono K, Pico A, Pratt D.<br/><b>NDEx IQuery: a multi-method network gene set analysis leveraging the Network Data Exchange</b>.<br/> Bioinformatics. 2023 Mar 1;39(3):btad118.<br/><a href=\"https://doi/org/10.1093/bioinformatics/btad118\">doi: 10.1093/bioinformatics/btad118</a></p>","@context":"{\"chebi\": \"https://identifiers.org/chebi/CHEBI:\", \"uniprot\": \"https://identifiers.org/uniprot/\", \"cas\": \"https://identifiers.org/cas/\", \"hgnc.symbol\": \"https://identifiers.org/hgnc.symbol/\"}"}]},{"nodes":[{"id":0,"x":1890,"y":1680,"v":{"n":"ARNT","r":"uniprot:B2R9H1","type":"protein","alias":["uniprot:C4AMA1","uniprot:F8WAP6","uniprot:P27540","uniprot:Q59ED4","uniprot:Q5QP39","uniprot:Q8NDC7"]}},{"id":1,"x":1610,"y":1680,"v":{"n":"HIF1A","r":"uniprot:C0LZJ3","type":"protein","alias":["uniprot:Q16665","uniprot:Q53XP6","uniprot:Q96PT9","uniprot:Q9UPB1"]}},{"id":2,"x":1890,"y":1400,"v":{"n":"HIF3A","r":"uniprot:B0M185","type":"protein","alias":["uniprot:B4DNA2","uniprot:I6L988","uniprot:Q58A43","uniprot:Q66K72","uniprot:Q8WXA1","uniprot:Q96K34","uniprot:Q9H7Z9","uniprot:Q9HAI2","uniprot:Q9Y2N7"]}},{"id":3,"x":1330,"y":1540,"v":{"n":"CDKN2A","r":"uniprot:D3DRK2","type":"protein","alias":["uniprot:Q13195","uniprot:Q13399","uniprot:Q16360","uniprot:Q7KZR9","uniprot:Q8N726"]}},{"id":4,"x":1470,"y":1820,"v":{"n":"COPS5","r":"uniprot:O15386","type":"protein","alias":["uniprot:Q6AW95","uniprot:Q86WQ4","uniprot:Q92905","uniprot:Q9BQ17"]}},{"id":5,"x":1750,"y":1680,"v":{"n":"TP53","r":"uniprot:P04637","type":"protein","alias":["uniprot:Q15086","uniprot:Q15087","uniprot:Q15088","uniprot:Q16535","uniprot:Q16807","uniprot:Q16808","uniprot:Q16809","uniprot:Q16810","uniprot:Q16811","unipr