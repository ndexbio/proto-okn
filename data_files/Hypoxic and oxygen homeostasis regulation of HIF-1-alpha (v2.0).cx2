agents?subject=CDKN2A&object=TP53&type=Methylation&format=html&expand_all=true\" target=\"INDRA_Evidence\">4</a>)<li/>CDKN2A ubiquitinates TP53(<a href=\"https://db.indra.bio/statements/from_agents?subject=CDKN2A&object=TP53&type=Ubiquitination&format=html&expand_all=true\" target=\"INDRA_Evidence\">3</a>)<li/>CDKN2A sumoylates TP53(<a href=\"https://db.indra.bio/statements/from_agents?subject=CDKN2A&object=TP53&type=Sumoylation&format=html&expand_all=true\" target=\"INDRA_Evidence\">3</a>)<li/>CDKN2A deubiquitinates TP53(<a href=\"https://db.indra.bio/statements/from_agents?subject=CDKN2A&object=TP53&type=Deubiquitination&format=html&expand_all=true\" target=\"INDRA_Evidence\">2</a>)<li/>TP53 binds CDKN2A(<a href=\"https://db.indra.bio/statements/from_agents?subject=TP53&object=CDKN2A&type=Complex&format=html&expand_all=true\" target=\"INDRA_Evidence\">230</a>)<li/>TP53 activates CDKN2A(<a href=\"https://db.indra.bio/statements/from_agents?subject=TP53&object=CDKN2A&type=Activation&format=html&expand_all=true\" target=\"INDRA_Evidence\">67</a>)<li/>TP53 inhibits CDKN2A(<a href=\"https://db.indra.bio/statements/from_agents?subject=TP53&object=CDKN2A&type=Inhibition&format=html&expand_all=true\" target=\"INDRA_Evidence\">58</a>)<li/>TP53 increases the amount of CDKN2A(<a href=\"https://db.indra.bio/statements/from_agents?subject=TP53&object=CDKN2A&type=IncreaseAmount&format=html&expand_all=true\" target=\"INDRA_Evidence\">41</a>)<li/>TP53 decreases the amount of CDKN2A(<a href=\"https://db.indra.bio/statements/from_agents?subject=TP53&object=CDKN2A&type=DecreaseAmount&format=html&expand_all=true\" target=\"INDRA_Evidence\">25</a>)<li/>TP53 methylates CDKN2A(<a href=\"https://db.indra.bio/statements/from_agents?subject=TP53&object=CDKN2A&type=Methylation&format=html&expand_all=true\" target=\"INDRA_Evidence\">2</a>)</ul>","__edge_source":"INDRA","__relationship_score":7.116394144093465,"__directed":true,"__reverse_directed":true,"i":"interacts with"}},{"id":76,"s":4,"