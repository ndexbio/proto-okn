[{"CXVersion":"2.0","hasFragments":false},{"metaData":[{"name":"networkAttributes","elementCount":1},{"name":"visualProperties","elementCount":1},{"name":"visualEditorProperties","elementCount":1},{"name":"attributeDeclarations","elementCount":1},{"name":"nodes","elementCount":61},{"name":"edges","elementCount":487}]},{"attributeDeclarations":[{"nodes":{"represents":{"a":"r","d":"string"},"name":{"a":"n","d":"string"},"member":{"d":"list_of_string"},"alias":{"d":"list_of_string"},"type":{"v":"protein","d":"string"}},"networkAttributes":{"reference":{"d":"string"},"name":{"d":"string"},"description":{"d":"string"},"version":{"d":"string"},"@context":{"d":"string"}},"edges":{"Relationships":{"d":"string"},"__relationship_score":{"d":"double"},"interaction":{"a":"i","d":"string"},"__directed":{"v":true,"d":"boolean"},"__reverse_directed":{"v":false,"d":"boolean"},"__edge_source":{"v":"INDRA","d":"string"}}}]},{"networkAttributes":[{"name":"Neurotrophic factor-mediated Trk receptor signaling (v2.0)","description":"<p>This is the updated version of an original NCI Pathway Interaction Database (PID) network.</p><p>The list of entities (genes, proteins, chemicals, etc) from the original network was used to query the <a href=\"https://www.indra.bio\" target=\"_blank\"><b>INDRA</b></a> database, retrieving high-quality relationships between entities. INDRA is a database that integrates information from multiple high-quality text mining engines, pathway databases, and small molecule resources. The INDRA-derived relationships are up-to-date and have links to detailed summaries of supporting literature evidence, including the specific supporting text.</p><p>While we have included only high-confidence relationships, text-mining complicated sentences can produce errors such as the reversal of up-regulation vs. down-regulation or the direction of an edge (i.e. B activates A instead of A activates B). Nevertheless, the entity recognition by the text miners is excellent and the text supporting a relationship almost always describes a genuine relationship between the entities.</p><p><b>Legend:</b><br/>BLUE: edges annotated by INDRA only.<br/>RED: edges annotated both by INDRA and PID.<br/>YELLOW: selected element.</p>","version":"2.0 (20220901)","reference":"<p>Pillich RT, Chen J, Churas C, Fong D, Gyori BM, Ideker T, Karis K, Liu SN, Ono K, Pico A, Pratt D.<br/><b>NDEx IQuery: a multi-method network gene set analysis leveraging the Network Data Exchange</b>.<br/> Bioinformatics. 2023 Mar 1;39(3):btad118.<br/><a href=\"https://doi/org/10.1093/bioinformatics/btad118\">doi: 10.1093/bioinformatics/btad118</a></p>","@context":"{\"chebi\": \"https://identifiers.org/chebi/CHEBI:\", \"uniprot\": \"https://identifiers.org/uniprot/\", \"cas\": \"https://identifiers.org/cas/\", \"hgnc.symbol\": \"https://identifiers.org/hgnc.symbol/\"}"}]},{"nodes":[{"id":0,"x":2660,"y":3010,"v":{"n":"ABL1","r":"uniprot:A3KFJ3","alias":["uniprot:P00519","uniprot:Q13869","uniprot:Q13870","uniprot:Q16133","uniprot:Q17R61","uniprot:Q45F09"]}},{"id":1,"x":2800,"y":3010,"v":{"n":"NTRK1","r":"uniprot:B2R6T5","alias":["uniprot:B7ZM34","uniprot:P04629","uniprot:P08119","uniprot:Q15655","uniprot:Q15656","uniprot:Q5D056","uniprot:Q5VZS2","uniprot:Q7Z5C3","uniprot:Q9UIU7"]}},{"id":2,"x":3150,"y":3220,"v":{"n":"ACKR1","r":"uniprot:A8YPG5","alias":["uniprot:O75898","uniprot:Q16300","uniprot:Q16570","uniprot:Q8WWE3","uniprot:Q9UJP0","uniprot:Q9UKZ5","uniprot:Q9UKZ6","uniprot:Q9UQE1"]}},{"id":3,"x":2870,"y":2940,"v":{"n":"NGF","r":"uniprot:A1A4E5","alias":["uniprot:P01138","uniprot:Q6FHA0","uniprot:Q96P60","uniprot:Q9P2Q8","uniprot:Q9UKL8"]}},{"id":4,"x":2660,"y":2520,"v":{"n":"RHOG","r":"uniprot:P35238","alias":["uniprot:P84095","uniprot:Q8NI04"]}},{"id":5,"x":2800,"y":3570,"v":{"n":"ARHGAP32","r":"uniprot:A7KAX9","alias":["uniprot:I7H0B0","uniprot:O94820","uniprot:Q86YL6","uniprot:Q8IUG4","uniprot:Q9BWG3"]}},{"id":6,"x":2660,"y":2800,"v":{"n":"CDC42","r":"uniprot:P21181","alias":["un