[{"CXVersion":"2.0","hasFragments":false},{"metaData":[{"name":"networkAttributes","elementCount":1},{"name":"visualProperties","elementCount":1},{"name":"visualEditorProperties","elementCount":1},{"name":"attributeDeclarations","elementCount":1},{"name":"nodes","elementCount":23},{"name":"edges","elementCount":95}]},{"attributeDeclarations":[{"nodes":{"represents":{"a":"r","d":"string"},"name":{"a":"n","d":"string"},"member":{"d":"list_of_string"},"alias":{"d":"list_of_string"},"type":{"d":"string"}},"networkAttributes":{"reference":{"d":"string"},"name":{"d":"string"},"description":{"d":"string"},"version":{"d":"string"},"@context":{"d":"string"}},"edges":{"Relationships":{"d":"string"},"__relationship_score":{"d":"double"},"interaction":{"a":"i","d":"string"},"__directed":{"v":true,"d":"boolean"},"__reverse_directed":{"d":"boolean"},"__edge_source":{"v":"INDRA","d":"string"}}}]},{"networkAttributes":[{"name":"p38 MAPK signaling pathway (v2.0)","description":"<p>This is the updated version of an original NCI Pathway Interaction Database (PID) network.</p><p>The list of entities (genes, proteins, chemicals, etc) from the original network was used to query the <a href=\"https://www.indra.bio\" target=\"_blank\"><b>INDRA</b></a> database, retrieving high-quality relationships between entities. INDRA is a database that integrates information from multiple high-quality text mining engines, pathway databases, and small molecule resources. The INDRA-derived relationships are up-to-date and have links to detailed summaries of supporting literature evidence, including the specific supporting text.</p><p>While we have included only high-confidence relationships, text-mining complicated sentences can produce errors such as the reversal of up-regulation vs. down-regulation or the direction of an edge (i.e. B activates A instead of A activates B). Nevertheless, the entity recognition by the text miners is excellent and the text supporting a relationship almost always describes a genuine relationship between the entities.</p><p><b>Legend:</b><br/>BLUE: edges annotated by INDRA only.<br/>RED: edges annotated both by INDRA and PID.<br/>YELLOW: selected element.</p>","version":"2.0 (20220901)","reference":"<p>Pillich RT, Chen J, Churas C, Fong D, Gyori BM, Ideker T, Karis K, Liu SN, Ono K, Pico A, Pratt D.<br/><b>NDEx IQuery: a multi-method network gene set analysis leveraging the Network Data Exchange</b>.<br/> Bioinformatics. 2023 Mar 1;39(3):btad118.<br/><a href=\"https://doi/org/10.1093/bioinformatics/btad118\">doi: 10.1093/bioinformatics/btad118</a></p>","@context":"{\"chebi\": \"https://identifiers.org/chebi/CHEBI:\", \"uniprot\": \"https://identifiers.org/uniprot/\", \"cas\": \"https://identifiers.org/cas/\", \"hgnc.symbol\": \"https://identifiers.org/hgnc.symbol/\"}"}]},{"nodes":[{"id":0,"x":1960,"y":1890,"v":{"n":"ATM","r":"uniprot:B2RNX5","type":"protein","alias":["uniprot:O15429","uniprot:Q12758","uniprot:Q13315","uniprot:Q16551","uniprot:Q93007","uniprot:Q9NP02","uniprot:Q9UCX7"]}},{"id":2,"x":2240,"y":1610,"v":{"n":"TAOK1","r":"uniprot:A2RUT8","type":"protein","alias":["uniprot:B7ZLV6","uniprot:Q7L7X3","uniprot:Q96L75","uniprot:Q9H2K7","uniprot:Q9H7S5","uniprot:Q9P2I6"]}},{"id":3,"x":2030,"y":1680,"v":{"n":"TAOK2","r":"uniprot:A5PKY1","type":"protein","alias":["uniprot:A7MCZ2","uniprot:B2RN35","uniprot:B7ZM88","uniprot:O94957","uniprot:Q6UW73","uniprot:Q7LC09","uniprot:Q9NSW2","uniprot:Q9UL54"]}},{"id":4,"x":1960,"y":1750,"v":{"n":"TAOK3","r":"uniprot:Q658N1","type":"protein","alias":["uniprot:Q8IUM4","uniprot:Q9H2K8","uniprot:Q9HC79","uniprot:Q9NZM9","uniprot:Q9UHG7"]}},{"id":5,"x":1610,"y":1540,"v":{"n":"CALM1","r":"uniprot:P02593","type":"protein","alias":["uniprot:P62158","uniprot:P70667","uniprot:P99014","uniprot:Q13942","uniprot:Q53S29","uniprot:Q61379","uniprot:Q61380","uniprot:Q96HK3"]}},{"id":7,"x":2100,"y":2030,"v":{"n":"GADD45 family","r":"GADD45 family","member":["hgnc.symbol:GADD45A","hgnc.symbol:GADD45B","hgnc.symb