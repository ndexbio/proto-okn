[{"CXVersion":"2.0","hasFragments":false},{"metaData":[{"name":"networkAttributes","elementCount":1},{"name":"visualProperties","elementCount":1},{"name":"visualEditorProperties","elementCount":1},{"name":"attributeDeclarations","elementCount":1},{"name":"nodes","elementCount":8},{"name":"edges","elementCount":12}]},{"attributeDeclarations":[{"nodes":{"represents":{"a":"r","d":"string"},"name":{"a":"n","d":"string"},"alias":{"d":"list_of_string"},"type":{"d":"string"}},"networkAttributes":{"reference":{"d":"string"},"name":{"d":"string"},"description":{"d":"string"},"version":{"d":"string"},"@context":{"d":"string"}},"edges":{"Relationships":{"d":"string"},"__relationship_score":{"d":"double"},"interaction":{"a":"i","d":"string"},"__directed":{"d":"boolean"},"__reverse_directed":{"d":"boolean"},"__edge_source":{"d":"string"}}}]},{"networkAttributes":[{"name":"Glypican 3 network (v2.0)","description":"<p>This is the updated version of an original NCI Pathway Interaction Database (PID) network.</p><p>The list of entities (genes, proteins, chemicals, etc) from the original network was used to query the <a href=\"https://www.indra.bio\" target=\"_blank\"><b>INDRA</b></a> database, retrieving high-quality relationships between entities. INDRA is a database that integrates information from multiple high-quality text mining engines, pathway databases, and small molecule resources. The INDRA-derived relationships are up-to-date and have links to detailed summaries of supporting literature evidence, including the specific supporting text.</p><p>While we have included only high-confidence relationships, text-mining complicated sentences can produce errors such as the reversal of up-regulation vs. down-regulation or the direction of an edge (i.e. B activates A instead of A activates B). Nevertheless, the entity recognition by the text miners is excellent and the text supporting a relationship almost always describes a genuine relationship between the entities.</p><p><b>Legend:</b><br/>BLUE: edges annotated by INDRA only.<br/>RED: edges annotated both by INDRA and PID.<br/>YELLOW: selected element.</p>","version":"2.0 (20220901)","reference":"<p>Pillich RT, Chen J, Churas C, Fong D, Gyori BM, Ideker T, Karis K, Liu SN, Ono K, Pico A, Pratt D.<br/><b>NDEx IQuery: a multi-method network gene set analysis leveraging the Network Data Exchange</b>.<br/> Bioinformatics. 2023 Mar 1;39(3):btad118.<br/><a href=\"https://doi/org/10.1093/bioinformatics/btad118\">doi: 10.1093/bioinformatics/btad118</a></p>","@context":"{\"chebi\": \"https://identifiers.org/chebi/CHEBI:\", \"uniprot\": \"https://identifiers.org/uniprot/\", \"cas\": \"https://identifiers.org/cas/\", \"hgnc.symbol\": \"https://identifiers.org/hgnc.symbol/\"}"}]},{"nodes":[{"id":0,"x":1050,"y":1330,"v":{"n":"cholesterol","r":"CHEBI:16113","type":"smallmolecule"}},{"id":1,"x":1470,"y":1050,"v":{"n":"GPC3","r":"uniprot:C9JLE3","type":"protein","alias":["uniprot:G3V1R0","uniprot:P51654","uniprot:Q2L880","uniprot:Q2L882"]}},{"id":2,"x":1190,"y":1330,"v":{"n":"PTCH1","r":"uniprot:A3KBI9","type":"protein","alias":["uniprot:E9PEJ8","uniprot:Q13463","uniprot:Q13635","uniprot:Q5R1U7","uniprot:Q5R1U9","uniprot:Q5R1V0","uniprot:Q5VZC0","uniprot:Q5VZC2","uniprot:Q86XG7"]}},{"id":3,"x":1400,"y":1120,"v":{"n":"SHH","r":"uniprot:A4D247","type":"protein","alias":["uniprot:Q15465","uniprot:Q75MC9"]}},{"id":4,"x":1260,"y":1120,"v":{"n":"DKK1","r":"uniprot:B2RC19","type":"protein","alias":["uniprot:O94907"]}},{"id":5,"x":1050,"y":1050,"v":{"n":"FURIN","r":"uniprot:P09958","type":"protein","alias":["uniprot:Q14336","uniprot:Q6LBS3","uniprot:Q9UCZ5"]}},{"id":7,"x":1120,"y":1120,"v":{"n":"MAPK8","r":"uniprot:B5BTZ5","type":"protein","alias":["uniprot:B7ZLV4","uniprot:D3DX88","uniprot:D3DX92","uniprot:P45983","uniprot:Q15709","uniprot:Q15712","uniprot:Q15713","uniprot:Q308M2"]}},{"id":8,"x":980,"y":1190,"v":{"n":"MAPK9","r":"uniprot:A8K0S3","type":"protein","alias":["uniprot:B5BU66","uniprot:B5M0B4","uniprot:D3DWQ8","uniprot:D3DWQ9","uniprot:P45984","uniprot:Q15708","uniprot:Q15710","uniprot:Q15711","uniprot:Q8N5C5"]}}]},{"edges":[{"id":22,"s":7,"t":8,"v":{"Relationships":"All Evidences (<a href=\"https://db.indra.bio/statements/from_agents?agent0=MAPK8&agent1=MAPK9&format=html&expand_all=false\" target=\"INDRA_Evidence\">116</a>)<ul><li/>MAPK9 binds MAPK8(<a href=\"https://db.indra.bio/statements/from_agents?subject=MAPK9&object=MAPK8&type=Complex&format=html&expand_all=true\" target=\"INDRA_Evidence\">36</a>)<li/>MAPK9 inhibits MAPK8(<a href=\"https://db.indra.bio/statements/from_agents?subject=MAPK9&object=MAPK8&type=Inhibition&format=html&expand_all=true\" target=\"INDRA_Evidence\">25</a>)<li/>MAPK9 activates MAPK8(<a href=\"https://db.indra.bio/statements/from_agents?subject=MAPK9&object=MAPK8&type=Activation&format=html&expand_all=true\" target=\"INDRA_Evidence\">11</a>)<li/>MAPK9 phosphorylates MAPK8(<a href=\"https://db.indra.bio/statements/from_agents?subject=MAPK9&object=MAPK8&type=Phosphorylation&format=html&expand_all=true\" target=\"INDRA_Evidence\">3</a>)<li/>MAPK9 increases the amount of MAPK8(<a href=\"https://db.indra.bio/statements/from_agents?subject=MAPK9&object=MAPK8&type=IncreaseAmount&format=html&expand_all=true\" target=\"INDRA_Evidence\">2</a>)<li/>MAPK9 decreases the amount of MAPK8(<a href=\"https://db.indra.bio/statements/from_agents?subject=MAPK9&object=MAPK8&type=DecreaseAmount&format=html&expand_all=true\" target=\"INDRA_Evidence\">2</a>)<li/>MAPK8 activates MAPK9(<a href=\"https://db.indra.bio/statements/from_agents?subject=MAPK8&object=MAPK9&type=Activation&format=html&expand_all=true\" target=\"INDRA_Evidence\">20</a>)<li/>MAPK8 inhibits MAPK9(<a href=\"https://db.indra.bio/statements/from_agents?subject=MAPK8&object=MAPK9&type=Inhibition&format=html&expand_all=true\" target=\"INDRA_Evidence\">8</a>)<li/>MAPK8 phosphorylates MAPK9(<a href=\"https://db.indra.bio/statements/from_agents?subject=MAPK8&object=MAPK9&type=Phosphorylation&format