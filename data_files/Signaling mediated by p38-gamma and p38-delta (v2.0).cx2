[{"CXVersion":"2.0","hasFragments":false},{"metaData":[{"name":"networkAttributes","elementCount":1},{"name":"visualProperties","elementCount":1},{"name":"visualEditorProperties","elementCount":1},{"name":"attributeDeclarations","elementCount":1},{"name":"nodes","elementCount":9},{"name":"edges","elementCount":16}]},{"attributeDeclarations":[{"nodes":{"represents":{"a":"r","d":"string"},"name":{"a":"n","d":"string"},"alias":{"d":"list_of_string"},"type":{"d":"string"}},"networkAttributes":{"reference":{"d":"string"},"name":{"d":"string"},"description":{"d":"string"},"version":{"d":"string"},"@context":{"d":"string"}},"edges":{"Relationships":{"d":"string"},"__relationship_score":{"d":"double"},"interaction":{"a":"i","d":"string"},"__directed":{"d":"boolean"},"__reverse_directed":{"d":"boolean"},"__edge_source":{"d":"string"}}}]},{"networkAttributes":[{"name":"Signaling mediated by p38-gamma and p38-delta (v2.0)","description":"<p>This is the updated version of an original NCI Pathway Interaction Database (PID) network.</p><p>The list of entities (genes, proteins, chemicals, etc) from the original network was used to query the <a href=\"https://www.indra.bio\" target=\"_blank\"><b>INDRA</b></a> database, retrieving high-quality relationships between entities. INDRA is a database that integrates information from multiple high-quality text mining engines, pathway databases, and small molecule resources. The INDRA-derived relationships are up-to-date and have links to detailed summaries of supporting literature evidence, including the specific supporting text.</p><p>While we have included only high-confidence relationships, text-mining complicated sentences can produce errors such as the reversal of up-regulation vs. down-regulation or the direction of an edge (i.e. B activates A instead of A activates B). Nevertheless, the entity recognition by the text miners is excellent and the text supporting a relationship almost always describes a genuine relationship between the entities.</p><p><b>Legend:</b><br/>BLUE: edges annotated by INDRA only.<br/>RED: edges annotated both by INDRA and PID.<br/>YELLOW: selected element.</p>","version":"2.0 (20220901)","reference":"<p>Pillich RT, Chen J, Churas C, Fong D, Gyori BM, Ideker T, Karis K, Liu SN, Ono K, Pico A, Pratt D.<br/><b>NDEx IQuery: a multi-method network gene set analysis leveraging the Network Data Exchange</b>.<br/> Bioinformatics. 2023 Mar 1;39(3):btad118.<br/><a href=\"https://doi/org/10.1093/bioinformatics/btad118\">doi: 10.1093/bioinformatics/btad118</a></p>","@context":"{\"chebi\": \"https://identifiers.org/chebi/CHEBI:\", \"uniprot\": \"https://identifiers.org/uniprot/\", \"cas\": \"https://identifiers.org/cas/\", \"hgnc.symbol\": \"https://identifiers.org/hgnc.symbol/\"}"}]},{"nodes":[{"id":1,"x":1120,"y":1190,"v":{"n":"MAPK12","r":"uniprot:P53778","type":"protein","alias":["uniprot:Q14260","uniprot:Q6IC53","uniprot:Q99588","uniprot:Q99672"]}},{"id":2,"x":1190,"y":1050,"v":{"n":"EEF2K","r":"uniprot:O00418","type":"protein","alias":["uniprot:Q8N588"]}},{"id":3,"x":1190,"y":910,"v":{"n":"MAPK13","r":"uniprot:O14739","type":"protein","alias":["uniprot:O15124","uniprot:O15264","uniprot:Q5U4A5","uniprot:Q6FI46","uniprot:Q9UNU0"]}},{"id":4,"x":1050,"y":910,"v":{"n":"MAP2K3","r":"uniprot:B3KSK7","type":"protein","alias":["uniprot:P46734","uniprot:Q99441","uniprot:Q9UE71","uniprot:Q9UE72"]}},{"id":5,"x":1050,"y":1050,"v":{"n":"MAP2K6","r":"uniprot:P52564","type":"protein"}},{"id":7,"x":980,"y":1260,"v":{"n":"MAPT","r":"uniprot:P10636","type":"protein","alias":["uniprot:P18518","uniprot:Q14799","uniprot:Q15549","uniprot:Q15550","uniprot:Q15551","uniprot:Q1RMF6","uniprot:Q53YB1","uniprot:Q5CZI7","uniprot:Q5XWF0","uniprot:Q6QT54","uniprot:Q9UDJ3","uniprot:Q9UMH0","uniprot:Q9UQ96"]}},{"id":8,"x":1190,"y":1260,"v":{"n":"SNTA1","r":"uniprot:A8K7H9","type":"protein","alias":["uniprot:B4DX40","uniprot:E1P5N1","uniprot:Q13424","uniprot:Q16438"]}},{"id":9,"x":1260,"y":840,"v":{"n":"STMN1","