[{"CXVersion":"2.0","hasFragments":false},{"metaData":[{"name":"networkAttributes","elementCount":1},{"name":"visualProperties","elementCount":1},{"name":"visualEditorProperties","elementCount":1},{"name":"attributeDeclarations","elementCount":1},{"name":"nodes","elementCount":35},{"name":"edges","elementCount":238}]},{"attributeDeclarations":[{"nodes":{"represents":{"a":"r","d":"string"},"name":{"a":"n","d":"string"},"alias":{"d":"list_of_string"},"type":{"d":"string"}},"networkAttributes":{"reference":{"d":"string"},"name":{"d":"string"},"description":{"d":"string"},"version":{"d":"string"},"@context":{"d":"string"}},"edges":{"Relationships":{"d":"string"},"__relationship_score":{"d":"double"},"interaction":{"a":"i","d":"string"},"__directed":{"v":true,"d":"boolean"},"__reverse_directed":{"v":true,"d":"boolean"},"__edge_source":{"v":"INDRA","d":"string"}}}]},{"networkAttributes":[{"name":"IL1-mediated signaling events (v2.0)","description":"<p>This is the updated version of an original NCI Pathway Interaction Database (PID) network.</p><p>The list of entities (genes, proteins, chemicals, etc) from the original network was used to query the <a href=\"https://www.indra.bio\" target=\"_blank\"><b>INDRA</b></a> database, retrieving high-quality relationships between entities. INDRA is a database that integrates information from multiple high-quality text mining engines, pathway databases, and small molecule resources. The INDRA-derived relationships are up-to-date and have links to detailed summaries of supporting literature evidence, including the specific supporting text.</p><p>While we have included only high-confidence relationships, text-mining complicated sentences can produce errors such as the reversal of up-regulation vs. down-regulation or the direction of an edge (i.e. B activates A instead of A activates B). Nevertheless, the entity recognition by the text miners is excellent and the text supporting a relationship almost always describes a genuine relationship between the entities.</p><p><b>Legend:</b><br/>BLUE: edges annotated by INDRA only.<br/>RED: edges annotated both by INDRA and PID.<br/>YELLOW: selected element.</p>","version":"2.0 (20220901)","reference":"<p>Pillich RT, Chen J, Churas C, Fong D, Gyori BM, Ideker T, Karis K, Liu SN, Ono K, Pico A, Pratt D.<br/><b>NDEx IQuery: a multi-method network gene set analysis leveraging the Network Data Exchange</b>.<br/> Bioinformatics. 2023 Mar 1;39(3):btad118.<br/><a href=\"https://doi/org/10.1093/bioinformatics/btad118\">doi: 10.1093/bioinformatics/btad118</a></p>","@context":"{\"chebi\": \"https://identifiers.org/chebi/CHEBI:\", \"uniprot\": \"https://identifiers.org/uniprot/\", \"cas\": \"https://identifiers.org/cas/\", \"hgnc.symbol\": \"https://identifiers.org/hgnc.symbol/\"}"}]},{"nodes":[{"id":1,"x":2310,"y":2590,"v":{"n":"CHUK","r":"uniprot:O14666","type":"protein","alias":["uniprot:O15111","uniprot:Q13132","uniprot:Q5W0I4","uniprot:Q92467"]}},{"id":2,"x":2240,"y":2660,"v":{"n":"ERC1","r":"uniprot:A2RU77","type":"protein","alias":["uniprot:A7E295","uniprot:D3DUP7","uniprot:D3DUP8","uniprot:Q6NVK2","uniprot:Q8IUD2","uniprot:Q8IUD3","uniprot:Q8IUD4","uniprot:Q8IUD5","uniprot:Q8NAS1","uniprot:Q9NXN5","uniprot:Q9UIK7","uniprot:Q9UPS1"]}},{"id":3,"x":1960,"y":2590,"v":{"n":"IKBKB","r":"uniprot:B4DZ30","type":"protein","alias":["uniprot:B4E0U4","uniprot:O14920","uniprot:O75327"]}},{"id":4,"x":2100,"y":2660,"v":{"n":"IKBKG","r":"uniprot:Q7LBY6","type":"protein","alias":["uniprot:Q7Z7F1","uniprot:Q9Y6K9"]}},{"id":5,"x":2100,"y":2450,"v":{"n":"IRAK1","r":"uniprot:D3DWW3","type":"protein","alias":["uniprot:D3DWW4","uniprot:P51617","uniprot:Q7Z5V4","uniprot:Q96C06","uniprot:Q96RL2"]}},{"id":6,"x":1750,"y":2520,"v":{"n":"MAP3K3","r":"uniprot:B2RCW2","type":"protein","alias":["uniprot:D3DU15","uniprot:Q5BKZ6","uniprot:Q8N3I9","uniprot:Q99759"]}},{"id":7,"x":2240,"y":2450,"v":{"n":"MAP3K7","r":"uniprot:B2RE27","type":"protein","alias":["uniprot:E1P523","uniprot:O43317","un