5","uniprot:Q8NHQ5","uniprot:Q92749"]}}]},{"edges":[{"id":224,"s":2,"t":16,"v":{"Relationships":"All Evidences (<a href=\"https://db.indra.bio/statements/from_agents?agent0=CUL3&agent1=CTNNB1&format=html&expand_all=false\" target=\"INDRA_Evidence\">4</a>)<ul><li/>CUL3 binds CTNNB1(<a href=\"https://db.indra.bio/statements/from_agents?subject=CUL3&object=CTNNB1&type=Complex&format=html&expand_all=true\" target=\"INDRA_Evidence\">2</a>)<li/>CUL3 inhibits CTNNB1(<a href=\"https://db.indra.bio/statements/from_agents?subject=CUL3&object=CTNNB1&type=Inhibition&format=html&expand_all=true\" target=\"INDRA_Evidence\">2</a>)</ul>","__edge_source":"INDRA","__relationship_score":1.3862943611198906,"__directed":false,"i":"interacts with"}},{"id":230,"s":2,"t":12,"v":{"Relationships":"All Evidences (<a href=\"https://db.indra.bio/statements/from_agents?agent0=CTNNB1&agent1=WNT3A&format=html&expand_all=false\" target=\"INDRA_Evidence\">1024</a>)<ul><li/>WNT3A activates CTNNB1(<a href=\"https://db.indra.bio/statements/from_agents?subject=WNT3A&object=CTNNB1&type=Activation&format=html&expand_all=true\" target=\"INDRA_Evidence\">690</a>)<li/>WNT3A increases the amount of CTNNB1(<a href=\"https://db.indra.bio/statements/from_agents?subject=WNT3A&object=CTNNB1&type=IncreaseAmount&format=html&expand_all=true\" target=\"INDRA_Evidence\">116</a>)<li/>WNT3A inhibits CTNNB1(<a href=\"https://db.indra.bio/statements/from_agents?subject=WNT3A&object=CTNNB1&type=Inhibition&format=html&expand_all=true\" target=\"INDRA_Evidence\">78</a>)<li/>WNT3A phosphorylates CTNNB1(<a href=\"https://db.indra.bio/statements/from_agents?subject=WNT3A&object=CTNNB1&type=Phosphorylation&format=html&expand_all=true\" target=\"INDRA_Evidence\">30</a>)<li/>WNT3A binds CTNNB1(<a href=\"https://db.indra.bio/statements/from_agents?subject=WNT3A&object=CTNNB1&type=Complex&format=html&expand_all=true\" target=\"INDRA_Evidence\">25</a>)<li/>WNT3A dephosphorylates CTNNB1(<a href=\"https://db.indra.bio/statements/from_agents?subject=WNT3A&object=CTNNB1&type=Dephosphorylation&format=html&expand_all=true\" target=\"INDRA_Evidence\">17</a>)<li/>WNT3A decreases the amount of CTNNB1(<a href=\"https://db.indra.bio/statements/from_agents?subject=WNT3A&object=CTNNB1&type=DecreaseAmount&format=html&expand_all=true\" target=\"INDRA_Evidence\">15</a>)<li/>WNT3A acetylates CTNNB1(<a href=\"https://db.indra.bio/statements/from_agents?subject=WNT3A&object=CTNNB1&type=Acetylation&format=html&expand_all=true\" target=\"INDRA_Evidence\">2</a>)<li/>CTNNB1 activates WNT3A(<a href=\"https://db.indra.bio/statements/from_agents?subject=CTNNB1&object=WNT3A&type=Activation&format=html&expand_all=true\" target=\"INDRA_Evidence\">22</a>)<li/>CTNNB1 inhibits WNT3A(<a href=\"https://db.indra.bio/statements/from_agents?subject=CTNNB1&object=WNT3A&type=Inhibition&format=html&expand_all=true\" target=\"INDRA_Evidence\">18</a>)<li/>CTNNB1 increases the amount of WNT3A(<a href=\"https://db.indra.bio/statements/from_agents?subject=CTNNB1&object=WNT3A&type=IncreaseAmount&format=html&expand_all=true\" target=\"INDRA_Evidence\">8</a>)<li/>CTNNB1 decreases the amount of WNT3A(<a href=\"https://db.indra.bio/statements/from_agents?subject=CTNNB1&object=WNT3A&type=DecreaseAmount&format=html&expand_all=true\" target=\"INDRA_Evidence\">3</a>)</ul>","__edge_source":"INDRA","__relationship_score":6.931471805599453,"__directed":true,"i":"interacts with"}},{"id":235,"s":0,"t":12,"v":{"Relationships":"All Evidences (<a href=\"https://db.indra.bio/statements/from_agents?agent0=WNT3A&agent1=APC&format=html&expand_all=false\" target=\"INDRA_Evidence\">2</a>)<ul><li/>WNT3A activates APC(<a href=\"https://db.indra.bio/statements/from_agents?subject=WNT3A&object=APC&type=Activation&format=html&expand_all=true\" target=\"INDRA_Evidence\">2</a>)</ul>","__edge_source":"INDRA","__relationship_score":0.6931471805599453,"__directed":false,"i":"interacts with"}},{"id":243,"s":0,"t":4,"v":{"Relationships":"All Evidences (<a href=\"https://db.