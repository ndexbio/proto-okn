[{"CXVersion":"2.0","hasFragments":false},{"metaData":[{"name":"networkAttributes","elementCount":1},{"name":"visualProperties","elementCount":1},{"name":"visualEditorProperties","elementCount":1},{"name":"attributeDeclarations","elementCount":1},{"name":"nodes","elementCount":17},{"name":"edges","elementCount":45}]},{"attributeDeclarations":[{"nodes":{"represents":{"a":"r","d":"string"},"name":{"a":"n","d":"string"},"member":{"d":"list_of_string"},"alias":{"d":"list_of_string"},"type":{"d":"string"}},"networkAttributes":{"reference":{"d":"string"},"name":{"d":"string"},"description":{"d":"string"},"version":{"d":"string"},"@context":{"d":"string"}},"edges":{"Relationships":{"d":"string"},"__relationship_score":{"d":"double"},"interaction":{"a":"i","d":"string"},"__directed":{"d":"boolean"},"__reverse_directed":{"d":"boolean"},"__edge_source":{"d":"string"}}}]},{"networkAttributes":[{"name":"Sphingosine 1-phosphate (S1P) pathway (v2.0)","description":"<p>This is the updated version of an original NCI Pathway Interaction Database (PID) network.</p><p>The list of entities (genes, proteins, chemicals, etc) from the original network was used to query the <a href=\"https://www.indra.bio\" target=\"_blank\"><b>INDRA</b></a> database, retrieving high-quality relationships between entities. INDRA is a database that integrates information from multiple high-quality text mining engines, pathway databases, and small molecule resources. The INDRA-derived relationships are up-to-date and have links to detailed summaries of supporting literature evidence, including the specific supporting text.</p><p>While we have included only high-confidence relationships, text-mining complicated sentences can produce errors such as the reversal of up-regulation vs. down-regulation or the direction of an edge (i.e. B activates A instead of A activates B). Nevertheless, the entity recognition by the text miners is excellent and the text supporting a relationship almost always describes a genuine relationship between the entities.</p><p><b>Legend:</b><br/>BLUE: edges annotated by INDRA only.<br/>RED: edges annotated both by INDRA and PID.<br/>YELLOW: selected element.</p>","version":"2.0 (20220901)","reference":"<p>Pillich RT, Chen J, Churas C, Fong D, Gyori BM, Ideker T, Karis K, Liu SN, Ono K, Pico A, Pratt D.<br/><b>NDEx IQuery: a multi-method network gene set analysis leveraging the Network Data Exchange</b>.<br/> Bioinformatics. 2023 Mar 1;39(3):btad118.<br/><a href=\"https://doi/org/10.1093/bioinformatics/btad118\">doi: 10.1093/bioinformatics/btad118</a></p>","@context":"{\"chebi\": \"https://identifiers.org/chebi/CHEBI:\", \"uniprot\": \"https://identifiers.org/uniprot/\", \"cas\": \"https://identifiers.org/cas/\", \"hgnc.symbol\": \"https://identifiers.org/hgnc.symbol/\"}"}]},{"nodes":[{"id":0,"x":1330,"y":1890,"v":{"n":"ABCC1","r":"uniprot:A3RJX2","type":"protein","alias":["uniprot:C9JPJ4","uniprot:O14819","uniprot:O43333","uniprot:P33527","uniprot:P78419","uniprot:Q59GI9","uniprot:Q9UQ97","uniprot:Q9UQ99","uniprot:Q9UQA0"]}},{"id":1,"x":1400,"y":1540,"v":{"n":"sphingosine 1-phosphate","r":"CHEBI:37550","type":"smallmolecule"}},{"id":3,"x":1120,"y":1890,"v":{"n":"GNA12","r":"uniprot:A4D204","type":"protein","alias":["uniprot:B3KXS2","uniprot:B7Z3F7","uniprot:Q03113","uniprot:Q2T9L1","uniprot:Q5PPR5","uniprot:Q86UM8","uniprot:Q8TD71","uniprot:Q9UDU9"]}},{"id":4,"x":910,"y":1820,"v":{"n":"GNA13","r":"uniprot:B2R977","type":"protein","alias":["uniprot:B7Z7R0","uniprot:F5H1G8","uniprot:Q14344","uniprot:Q8TD70"]}},{"id":13,"x":1050,"y":1540,"v":{"n":"Gi family","r":"Gi family","member":["hgnc.symbol:GNAI1","hgnc.symbol:GNAI2","hgnc.symbol:GNAI3","hgnc.symbol:GNAO1","hgnc.symbol:GNAZ"],"type":"proteinfamily"}},{"id":14,"x":1190,"y":1400,"v":{"n":"Gq family","r":"Gq family","member":["hgnc.symbol:GNA11","hgnc.symbol:GNA14","hgnc.symbol:GNA15","hgnc.symbol:GNAQ"],"type":"proteinfamily"}},{"id":15,"x":980,"y":1680,"v":{"n":"S1PR1","r":"uniprot:D3DT66","type":"protein","alias":["uniprot:P21453","uniprot:Q9BYY4","uniprot:Q9NYN8"]}},{"id":16,"x":1120,"y":1750,"v":{"n":"S1PR2","r":"uniprot:O95136","type":"protein","alias":["uniprot:Q86UN8"]}},{"id":17,"x":1190,"y":1540,"v":{"n":"S1PR3","r":"uniprot:Q5SQD8","type":"protein","alias":["uniprot:Q7Z5I2","uniprot:Q99500"]}},{"id":18,"x":980,"y":1960,"v":{"n":"S1PR4","r":"uniprot:D6W612","type":"protein","alias":["uniprot:O95977"]}},{"id":19,"x":1260,"y":1680,"v":{"n":"S1PR5","r":"uniprot:Q6NW11","type":"protein","alias":["uniprot:Q9H228"]}},{"id":20,"x":1470,"y":1470,"v":{"n":"hexadecenal","r":"CHEBI:24547","type":"smallmolecule"}},{"id":21,"x":1400,"y":1400,"v":{"n":"SGPL1","r":"uniprot:B2RBD4","type":"protein","alias":["uniprot:O95470","uniprot:Q7Z732","uniprot:Q9ULG8","uniprot:Q9UN89"]}},{"id":22,"x":1540,"y":1610,"v":{"n":"SGPP1","r":"uniprot:B2RAH0","type":"protein","alias":["uniprot:Q9BX95","uniprot:Q9H189"]}},{"id":23,"x":1400,"y":1820,"v":{"n":"SPHK1","r":"uniprot:Q8N632","type":"protein","alias":["uniprot:Q96GK1","uniprot:Q9HD92","uniprot:Q9NY70","uniprot:Q9NYA1","uniprot:Q9NYL3"]}},{"id":24,"x":1610,"y":1960,"v":{"n":"SPHK2","r":"uniprot:A0T4C8","type":"protein","alias":["uniprot:B4DU87","uniprot:Q9BRN1","uniprot:Q9H0Q2","uniprot:Q9NRA0","uniprot:Q9NWU7"]}},{"id":25,"x":1540,"y":1890,"v":{"n":"SPHK1","r":"SPHK","type":"protein"}}]},{"edges":[{"id":178,"s":13,"t":13,"v":{"Relationships":"All Evidences (<a href=\"https://db.indra.bio/statements/from_agents?agent0=GNAI3&agent1=GNAZ&format=html&expand_all=false\" target=\"INDRA_Evidence\">50</a>)<ul><li/>GNAO1 binds GNAI1(<a href=\"https://db.indra.bio/statements/from_agents?subject=GNAO1&object=GNAI1&type=Complex&format=html&expand_all=true\" target=\"INDRA_Evidence\">5</a>)<li/>GNAO1 binds GNAI3(<a href=\"https://db.indra.bio/statements/from_agents?subject=GNAO1&object=GNAI3&type=Complex&format=html&expand_all=true\" target=\"INDRA_Evidence\">2</a>)<li/>GNAO1 binds GNAI2(<a href=\"https://db.indra.bio/statements/from_ag