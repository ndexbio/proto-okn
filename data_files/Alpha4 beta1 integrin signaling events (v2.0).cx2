e=DecreaseAmount&format=html&expand_all=true\" target=\"INDRA_Evidence\">16</a>)<li/>SRC dephosphorylates PTK2(<a href=\"https://db.indra.bio/statements/from_agents?subject=SRC&object=PTK2&type=Dephosphorylation&format=html&expand_all=true\" target=\"INDRA_Evidence\">14</a>)<li/>SRC increases the amount of PTK2(<a href=\"https://db.indra.bio/statements/from_agents?subject=SRC&object=PTK2&type=IncreaseAmount&format=html&expand_all=true\" target=\"INDRA_Evidence\">7</a>)<li/>PTK2 activates SRC(<a href=\"https://db.indra.bio/statements/from_agents?subject=PTK2&object=SRC&type=Activation&format=html&expand_all=true\" target=\"INDRA_Evidence\">195</a>)<li/>PTK2 phosphorylates SRC(<a href=\"https://db.indra.bio/statements/from_agents?subject=PTK2&object=SRC&type=Phosphorylation&format=html&expand_all=true\" target=\"INDRA_Evidence\">51</a>)<li/>PTK2 inhibits SRC(<a href=\"https://db.indra.bio/statements/from_agents?subject=PTK2&object=SRC&type=Inhibition&format=html&expand_all=true\" target=\"INDRA_Evidence\">24</a>)<li/>PTK2 dephosphorylates SRC(<a href=\"https://db.indra.bio/statements/from_agents?subject=PTK2&object=SRC&type=Dephosphorylation&format=html&expand_all=true\" target=\"INDRA_Evidence\">6</a>)<li/>PTK2 increases the amount of SRC(<a href=\"https://db.indra.bio/statements/from_agents?subject=PTK2&object=SRC&type=IncreaseAmount&format=html&expand_all=true\" target=\"INDRA_Evidence\">3</a>)</ul>","__relationship_score":7.9868449011613825,"i":"interacts with"}},{"id":258,"s":8,"t":13,"v":{"Relationships":"All Evidences (<a href=\"https://db.indra.bio/statements/from_agents?agent0=PXN&agent1=SRC&format=html&expand_all=false\" target=\"INDRA_Evidence\">324</a>)<ul><li/>SRC phosphorylates PXN(<a href=\"https://db.indra.bio/statements/from_agents?subject=SRC&object=PXN&type=Phosphorylation&format=html&expand_all=true\" target=\"INDRA_Evidence\">232</a>)<li/>SRC binds PXN(<a href=\"https://db.indra.bio/statements/from_agents?subject=SRC&object=PXN&type=Complex&format