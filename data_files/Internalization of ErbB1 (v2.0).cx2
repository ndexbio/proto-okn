[{"CXVersion":"2.0","hasFragments":false},{"metaData":[{"name":"networkAttributes","elementCount":1},{"name":"visualProperties","elementCount":1},{"name":"visualEditorProperties","elementCount":1},{"name":"attributeDeclarations","elementCount":1},{"name":"nodes","elementCount":34},{"name":"edges","elementCount":216}]},{"attributeDeclarations":[{"nodes":{"represents":{"a":"r","d":"string"},"name":{"a":"n","d":"string"},"member":{"d":"list_of_string"},"alias":{"d":"list_of_string"},"type":{"d":"string"}},"networkAttributes":{"reference":{"d":"string"},"name":{"d":"string"},"description":{"d":"string"},"version":{"d":"string"},"@context":{"d":"string"}},"edges":{"Relationships":{"d":"string"},"__relationship_score":{"d":"double"},"interaction":{"a":"i","d":"string"},"__directed":{"v":false,"d":"boolean"},"__reverse_directed":{"v":true,"d":"boolean"},"__edge_source":{"v":"INDRA","d":"string"}}}]},{"networkAttributes":[{"name":"Internalization of ErbB1 (v2.0)","description":"<p>This is the updated version of an original NCI Pathway Interaction Database (PID) network.</p><p>The list of entities (genes, proteins, chemicals, etc) from the original network was used to query the <a href=\"https://www.indra.bio\" target=\"_blank\"><b>INDRA</b></a> database, retrieving high-quality relationships between entities. INDRA is a database that integrates information from multiple high-quality text mining engines, pathway databases, and small molecule resources. The INDRA-derived relationships are up-to-date and have links to detailed summaries of supporting literature evidence, including the specific supporting text.</p><p>While we have included only high-confidence relationships, text-mining complicated sentences can produce errors such as the reversal of up-regulation vs. down-regulation or the direction of an edge (i.e. B activates A instead of A activates B). Nevertheless, the entity recognition by the text miners is excellent and the text supporting a relationship almost always describes a genuine relationship between the entities.</p><p><b>Legend:</b><br/>BLUE: edges annotated by INDRA only.<br/>RED: edges annotated both by INDRA and PID.<br/>YELLOW: selected element.</p>","version":"2.0 (20220901)","reference":"<p>Pillich RT, Chen J, Churas C, Fong D, Gyori BM, Ideker T, Karis K, Liu SN, Ono K, Pico A, Pratt D.<br/><b>NDEx IQuery: a multi-method network gene set analysis leveraging the Network Data Exchange</b>.<br/> Bioinformatics. 2023 Mar 1;39(3):btad118.<br/><a href=\"https://doi/org/10.1093/bioinformatics/btad118\">doi: 10.1093/bioinformatics/btad118</a></p>","@context":"{\"chebi\": \"https://identifiers.org/chebi/CHEBI:\", \"uniprot\": \"https://identifiers.org/uniprot/\", \"cas\": \"https://identifiers.org/cas/\", \"hgnc.symbol\": \"https://identifiers.org/hgnc.symbol/\"}"}]},{"nodes":[{"id":0,"x":2450,"y":2100,"v":{"n":"AMPH","r":"uniprot:A4D1X8","type":"protein","alias":["uniprot:A4D1X9","uniprot:O43538","uniprot:P49418","uniprot:Q75MJ8","uniprot:Q75MK5","uniprot:Q75MM3","uniprot:Q8N4G0"]}},{"id":1,"x":2450,"y":2240,"v":{"n":"DNM1","r":"uniprot:A6NLM6","type":"protein","alias":["uniprot:Q05193","uniprot:Q5SYX0","uniprot:Q5SYX2","uniprot:Q6P3T6","uniprot:Q86VD2"]}},{"id":2,"x":2030,"y":2240,"v":{"n":"EGFR","r":"uniprot:O00688","type":"protein","alias":["uniprot:O00732","uniprot:P00533","uniprot:P06268","uniprot:Q14225","uniprot:Q68GS5","uniprot:Q92795","uniprot:Q9BZS2","uniprot:Q9GZX1","uniprot:Q9H2C9","uniprot:Q9H3C9","uniprot:Q9UMD7","uniprot:Q9UMD8","uniprot:Q9UMG5"]}},{"id":3,"x":2100,"y":2170,"v":{"n":"EGF","r":"uniprot:B4DRK7","type":"protein","alias":["uniprot:E7EVD2","uniprot:E9PBF0","uniprot:P01133","uniprot:Q52LZ6"]}},{"id":4,"x":2170,"y":2240,"v":{"n":"EPN1","r":"uniprot:Q86ST3","type":"protein","alias":["uniprot:Q9HA18","uniprot:Q9Y6I3"]}},{"id":5,"x":2380,"y":2380,"v":{"n":"EPS15","r":"uniprot:B2R8J7","type":"protein","alias":["uniprot:D3DPJ2","uniprot:P42566","uniprot:Q5SRH4"]}},{"id":6,"x":2590,"y":2240,"v":{"n":"S