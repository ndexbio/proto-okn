[{"CXVersion":"2.0","hasFragments":false},{"metaData":[{"name":"networkAttributes","elementCount":1},{"name":"visualProperties","elementCount":1},{"name":"visualEditorProperties","elementCount":1},{"name":"attributeDeclarations","elementCount":1},{"name":"nodes","elementCount":24},{"name":"edges","elementCount":128}]},{"attributeDeclarations":[{"nodes":{"represents":{"a":"r","d":"string"},"name":{"a":"n","d":"string"},"alias":{"d":"list_of_string"},"type":{"d":"string"}},"networkAttributes":{"reference":{"d":"string"},"name":{"d":"string"},"description":{"d":"string"},"version":{"d":"string"},"@context":{"d":"string"}},"edges":{"Relationships":{"d":"string"},"__relationship_score":{"d":"double"},"interaction":{"a":"i","d":"string"},"__directed":{"v":true,"d":"boolean"},"__reverse_directed":{"v":true,"d":"boolean"},"__edge_source":{"v":"INDRA","d":"string"}}}]},{"networkAttributes":[{"name":"Signaling events mediated by HDAC Class III (v2.0)","description":"<p>This is the updated version of an original NCI Pathway Interaction Database (PID) network.</p><p>The list of entities (genes, proteins, chemicals, etc) from the original network was used to query the <a href=\"https://www.indra.bio\" target=\"_blank\"><b>INDRA</b></a> database, retrieving high-quality relationships between entities. INDRA is a database that integrates information from multiple high-quality text mining engines, pathway databases, and small molecule resources. The INDRA-derived relationships are up-to-date and have links to detailed summaries of supporting literature evidence, including the specific supporting text.</p><p>While we have included only high-confidence relationships, text-mining complicated sentences can produce errors such as the reversal of up-regulation vs. down-regulation or the direction of an edge (i.e. B activates A instead of A activates B). Nevertheless, the entity recognition by the text miners is excellent and the text supporting a relationship almost always describes a genuine relationship between the entities.</p><p><b>Legend:</b><br/>BLUE: edges annotated by INDRA only.<br/>RED: edges annotated both by INDRA and PID.<br/>YELLOW: selected element.</p>","version":"2.0 (20220901)","reference":"<p>Pillich RT, Chen J, Churas C, Fong D, Gyori BM, Ideker T, Karis K, Liu SN, Ono K, Pico A, Pratt D.<br/><b>NDEx IQuery: a multi-method network gene set analysis leveraging the Network Data Exchange</b>.<br/> Bioinformatics. 2023 Mar 1;39(3):btad118.<br/><a href=\"https://doi/org/10.1093/bioinformatics/btad118\">doi: 10.1093/bioinformatics/btad118</a></p>","@context":"{\"chebi\": \"https://identifiers.org/chebi/CHEBI:\", \"uniprot\": \"https://identifiers.org/uniprot/\", \"cas\": \"https://identifiers.org/cas/\", \"hgnc.symbol\": \"https://identifiers.org/hgnc.symbol/\"}"}]},{"nodes":[{"id":0,"x":1750,"y":1540,"v":{"n":"ACSS1","r":"uniprot:B3KXL2","type":"protein","alias":["uniprot:B4DJZ3","uniprot:D3DW48","uniprot:F5H6F4","uniprot:F8W7Y1","uniprot:Q5TF42","uniprot:Q8IV99","uniprot:Q8N234","uniprot:Q96JI1","uniprot:Q96JX6","uniprot:Q9NU28","uniprot:Q9NUB1"]}},{"id":1,"x":1610,"y":1610,"v":{"n":"SIRT3","r":"uniprot:B7Z5U6","type":"protein","alias":["uniprot:Q9NTG7","uniprot:Q9Y6E8"]}},{"id":2,"x":1890,"y":1820,"v":{"n":"ACSS2","r":"uniprot:A6NE90","type":"protein","alias":["uniprot:Q5QPH2","uniprot:Q5QPH3","uniprot:Q8N238","uniprot:Q96EL0","uniprot:Q9NQP7","uniprot:Q9NR19","uniprot:Q9UJ15"]}},{"id":3,"x":1890,"y":1960,"v":{"n":"SIRT1","r":"uniprot:Q2XNF6","type":"protein","alias":["uniprot:Q5JVQ0","uniprot:Q96EB6","uniprot:Q9GZR9","uniprot:Q9Y6F0"]}},{"id":4,"x":1890,"y":1680,"v":{"n":"BAX","r":"uniprot:A8K4W1","type":"protein","alias":["uniprot:P55269","uniprot:Q07812","uniprot:Q07814","uniprot:Q07815","uniprot:Q8WZ49","uniprot:Q9NR76","uniprot:Q9NYG7","uniprot:Q9UCZ6","uniprot:Q9UCZ7","uniprot:Q9UQD6"]}},{"id":5,"x":1890,"y":2240,"v":{"n":"XRCC6","r":"uniprot:B1AHC8","type":"protein","alias":["uniprot:P12956","uniprot:Q6FG89","uniprot:Q9UCQ2"