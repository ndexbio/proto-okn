[{"CXVersion":"2.0","hasFragments":false},{"metaData":[{"name":"networkAttributes","elementCount":1},{"name":"visualProperties","elementCount":1},{"name":"visualEditorProperties","elementCount":1},{"name":"attributeDeclarations","elementCount":1},{"name":"nodes","elementCount":26},{"name":"edges","elementCount":50}]},{"attributeDeclarations":[{"nodes":{"represents":{"a":"r","d":"string"},"name":{"a":"n","d":"string"},"alias":{"d":"list_of_string"},"type":{"d":"string"}},"networkAttributes":{"reference":{"d":"string"},"name":{"d":"string"},"description":{"d":"string"},"version":{"d":"string"},"@context":{"d":"string"}},"edges":{"Relationships":{"d":"string"},"__relationship_score":{"d":"double"},"interaction":{"a":"i","d":"string"},"__directed":{"d":"boolean"},"__reverse_directed":{"d":"boolean"},"__edge_source":{"d":"string"}}}]},{"networkAttributes":[{"name":"Integrin family cell surface interactions (v2.0)","description":"<p>This is the updated version of an original NCI Pathway Interaction Database (PID) network.</p><p>The list of entities (genes, proteins, chemicals, etc) from the original network was used to query the <a href=\"https://www.indra.bio\" target=\"_blank\"><b>INDRA</b></a> database, retrieving high-quality relationships between entities. INDRA is a database that integrates information from multiple high-quality text mining engines, pathway databases, and small molecule resources. The INDRA-derived relationships are up-to-date and have links to detailed summaries of supporting literature evidence, including the specific supporting text.</p><p>While we have included only high-confidence relationships, text-mining complicated sentences can produce errors such as the reversal of up-regulation vs. down-regulation or the direction of an edge (i.e. B activates A instead of A activates B). Nevertheless, the entity recognition by the text miners is excellent and the text supporting a relationship almost always describes a genuine relationship between the entities.</p><p><b>Legend:</b><br/>BLUE: edges annotated by INDRA only.<br/>RED: edges annotated both by INDRA and PID.<br/>YELLOW: selected element.</p>","version":"2.0 (20220901)","reference":"<p>Pillich RT, Chen J, Churas C, Fong D, Gyori BM, Ideker T, Karis K, Liu SN, Ono K, Pico A, Pratt D.<br/><b>NDEx IQuery: a multi-method network gene set analysis leveraging the Network Data Exchange</b>.<br/> Bioinformatics. 2023 Mar 1;39(3):btad118.<br/><a href=\"https://doi/org/10.1093/bioinformatics/btad118\">doi: 10.1093/bioinformatics/btad118</a></p>","@context":"{\"chebi\": \"https://identifiers.org/chebi/CHEBI:\", \"uniprot\": \"https://identifiers.org/uniprot/\", \"cas\": \"https://identifiers.org/cas/\", \"hgnc.symbol\": \"https://identifiers.org/hgnc.symbol/\"}"}]},{"nodes":[{"id":0,"x":2240,"y":2380,"v":{"n":"ITGA10","r":"uniprot:B2RAM4","type":"protein","alias":["uniprot:B2RTV5","uniprot:O75578","uniprot:Q6UXJ6","uniprot:Q9UHZ8"]}},{"id":1,"x":2240,"y":2240,"v":{"n":"ITGB1","r":"uniprot:A8K6N2","type":"protein","alias":["uniprot:D3DRX9","uniprot:D3DRY3","uniprot:D3DRY4","uniprot:D3DRY5","uniprot:P05556","uniprot:P78466","uniprot:P78467","uniprot:Q13089","uniprot:Q13090","uniprot:Q13091","uniprot:Q13212","uniprot:Q14622","uniprot:Q14647","uniprot:Q29RW2","uniprot:Q7Z3V1","uniprot:Q8WUM6"]}},{"id":2,"x":2170,"y":2170,"v":{"n":"ITGA11","r":"uniprot:J3KQM2","type":"protein","alias":["uniprot:Q8WYI8","uniprot:Q9UKQ1","uniprot:Q9UKX5"]}},{"id":3,"x":2660,"y":1820,"v":{"n":"ITGA1","r":"uniprot:B2RNU0","type":"protein","alias":["uniprot:P56199"]}},{"id":4,"x":1960,"y":1820,"v":{"n":"ITGA2B","r":"uniprot:B2RCY8","type":"protein","alias":["uniprot:O95366","uniprot:P08514","uniprot:Q14443","uniprot:Q17R67"]}},{"id":5,"x":1960,"y":1960,"v":{"n":"ITGB3","r":"uniprot:A0PJW2","type":"protein","alias":["uniprot:D3DXJ8","uniprot:O15495","uniprot:P05106","uniprot:Q12806","uniprot:Q13413","uniprot:Q14648","uniprot:Q16499"]}},{"id":6,"x":2100,"y":2030,"v":{"n":"ITGA2","r":"uniprot:P1