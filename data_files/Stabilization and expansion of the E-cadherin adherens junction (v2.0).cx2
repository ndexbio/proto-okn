[{"CXVersion":"2.0","hasFragments":false},{"metaData":[{"name":"networkAttributes","elementCount":1},{"name":"visualProperties","elementCount":1},{"name":"visualEditorProperties","elementCount":1},{"name":"attributeDeclarations","elementCount":1},{"name":"nodes","elementCount":43},{"name":"edges","elementCount":194}]},{"attributeDeclarations":[{"nodes":{"represents":{"a":"r","d":"string"},"name":{"a":"n","d":"string"},"alias":{"d":"list_of_string"},"type":{"d":"string"}},"networkAttributes":{"reference":{"d":"string"},"name":{"d":"string"},"description":{"d":"string"},"version":{"d":"string"},"@context":{"d":"string"}},"edges":{"Relationships":{"d":"string"},"__relationship_score":{"d":"double"},"interaction":{"a":"i","d":"string"},"__directed":{"v":true,"d":"boolean"},"__reverse_directed":{"v":true,"d":"boolean"},"__edge_source":{"v":"INDRA","d":"string"}}}]},{"networkAttributes":[{"name":"Stabilization and expansion of the E-cadherin adherens junction (v2.0)","description":"<p>This is the updated version of an original NCI Pathway Interaction Database (PID) network.</p><p>The list of entities (genes, proteins, chemicals, etc) from the original network was used to query the <a href=\"https://www.indra.bio\" target=\"_blank\"><b>INDRA</b></a> database, retrieving high-quality relationships between entities. INDRA is a database that integrates information from multiple high-quality text mining engines, pathway databases, and small molecule resources. The INDRA-derived relationships are up-to-date and have links to detailed summaries of supporting literature evidence, including the specific supporting text.</p><p>While we have included only high-confidence relationships, text-mining complicated sentences can produce errors such as the reversal of up-regulation vs. down-regulation or the direction of an edge (i.e. B activates A instead of A activates B). Nevertheless, the entity recognition by the text miners is excellent and the text supporting a relationship almost always describes a genuine relationship between the entities.</p><p><b>Legend:</b><br/>BLUE: edges annotated by INDRA only.<br/>RED: edges annotated both by INDRA and PID.<br/>YELLOW: selected element.</p>","version":"2.0 (20220901)","reference":"<p>Pillich RT, Chen J, Churas C, Fong D, Gyori BM, Ideker T, Karis K, Liu SN, Ono K, Pico A, Pratt D.<br/><b>NDEx IQuery: a multi-method network gene set analysis leveraging the Network Data Exchange</b>.<br/> Bioinformatics. 2023 Mar 1;39(3):btad118.<br/><a href=\"https://doi/org/10.1093/bioinformatics/btad118\">doi: 10.1093/bioinformatics/btad118</a></p>","@context":"{\"chebi\": \"https://identifiers.org/chebi/CHEBI:\", \"uniprot\": \"https://identifiers.org/uniprot/\", \"cas\": \"https://identifiers.org/cas/\", \"hgnc.symbol\": \"https://identifiers.org/hgnc.symbol/\"}"}]},{"nodes":[{"id":0,"x":2940,"y":2590,"v":{"n":"ABI1","r":"uniprot:A9Z1Y6","type":"protein","alias":["uniprot:B3KX62","uniprot:B4DQ58","uniprot:H7BXI6","uniprot:O15147","uniprot:O76049","uniprot:O95060","uniprot:Q5T2R3","uniprot:Q5T2R4","uniprot:Q5T2R6","uniprot:Q5T2R7","uniprot:Q5T2R9","uniprot:Q5W070","uniprot:Q5W072","uniprot:Q8IZP0","uniprot:Q8TB63","uniprot:Q96S81","uniprot:Q9NXZ9","uniprot:Q9NYB8"]}},{"id":1,"x":2940,"y":2450,"v":{"n":"CYFIP2","r":"uniprot:A6NLT2","type":"protein","alias":["uniprot:D3DQJ3","uniprot:Q53EN5","uniprot:Q96F07","uniprot:Q9NTK4","uniprot:Q9ULQ2","uniprot:Q9UN29"]}},{"id":2,"x":2590,"y":2520,"v":{"n":"DIAPH1","r":"uniprot:A6NF18","type":"protein","alias":["uniprot:B7ZKW2","uniprot:E9PEZ2","uniprot:O60610","uniprot:Q17RN4","uniprot:Q59FH8","uniprot:Q9UC76"]}},{"id":3,"x":3080,"y":2450,"v":{"n":"NCKAP1","r":"uniprot:O60329","type":"protein","alias":["uniprot:Q53QN5","uniprot:Q53S94","uniprot:Q53Y35","uniprot:Q9Y2A7"]}},{"id":4,"x":2380,"y":2170,"v":{"n":"RHOA","r":"uniprot:P06749","type":"protein","alias":["uniprot:P61586","uniprot:Q53HM4","uniprot:Q5U024","uniprot:Q9UDJ0","uniprot:Q9UEJ4"]}},{"id":5,"x":2660,"y":2660,"v":{"