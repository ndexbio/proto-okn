[{"CXVersion":"2.0","hasFragments":false},{"metaData":[{"name":"networkAttributes","elementCount":1},{"name":"visualProperties","elementCount":1},{"name":"visualEditorProperties","elementCount":1},{"name":"attributeDeclarations","elementCount":1},{"name":"nodes","elementCount":80},{"name":"edges","elementCount":618}]},{"attributeDeclarations":[{"nodes":{"represents":{"a":"r","d":"string"},"name":{"a":"n","d":"string"},"alias":{"d":"list_of_string"},"type":{"v":"protein","d":"string"}},"networkAttributes":{"reference":{"d":"string"},"name":{"d":"string"},"description":{"d":"string"},"version":{"d":"string"},"@context":{"d":"string"}},"edges":{"Relationships":{"d":"string"},"__relationship_score":{"d":"double"},"interaction":{"a":"i","d":"string"},"__directed":{"v":true,"d":"boolean"},"__reverse_directed":{"v":true,"d":"boolean"},"__edge_source":{"v":"INDRA","d":"string"}}}]},{"networkAttributes":[{"name":"p73 transcription factor network (v2.0)","description":"<p>This is the updated version of an original NCI Pathway Interaction Database (PID) network.</p><p>The list of entities (genes, proteins, chemicals, etc) from the original network was used to query the <a href=\"https://www.indra.bio\" target=\"_blank\"><b>INDRA</b></a> database, retrieving high-quality relationships between entities. INDRA is a database that integrates information from multiple high-quality text mining engines, pathway databases, and small molecule resources. The INDRA-derived relationships are up-to-date and have links to detailed summaries of supporting literature evidence, including the specific supporting text.</p><p>While we have included only high-confidence relationships, text-mining complicated sentences can produce errors such as the reversal of up-regulation vs. down-regulation or the direction of an edge (i.e. B activates A instead of A activates B). Nevertheless, the entity recognition by the text miners is excellent and the text supporting a relationship almost always describes a genuine relationship between the entities.</p><p><b>Legend:</b><br/>BLUE: edges annotated by INDRA only.<br/>RED: edges annotated both by INDRA and PID.<br/>YELLOW: selected element.</p>","version":"2.0 (20220901)","reference":"<p>Pillich RT, Chen J, Churas C, Fong D, Gyori BM, Ideker T, Karis K, Liu SN, Ono K, Pico A, Pratt D.<br/><b>NDEx IQuery: a multi-method network gene set analysis leveraging the Network Data Exchange</b>.<br/> Bioinformatics. 2023 Mar 1;39(3):btad118.<br/><a href=\"https://doi/org/10.1093/bioinformatics/btad118\">doi: 10.1093/bioinformatics/btad118</a></p>","@context":"{\"chebi\": \"https://identifiers.org/chebi/CHEBI:\", \"uniprot\": \"https://identifiers.org/uniprot/\", \"cas\": \"https://identifiers.org/cas/\", \"hgnc.symbol\": \"https://identifiers.org/hgnc.symbol/\"}"}]},{"nodes":[{"id":0,"x":3710,"y":3150,"v":{"n":"ABL1","r":"uniprot:A3KFJ3","alias":["uniprot:P00519","uniprot:Q13869","uniprot:Q13870","uniprot:Q16133","uniprot:Q17R61","uniprot:Q45F09"]}},{"id":1,"x":3500,"y":3080,"v":{"n":"TP73","r":"uniprot:B7Z7J4","alias":["uniprot:B7Z8Z1","uniprot:B7Z9C1","uniprot:C9J521","uniprot:O15350","uniprot:O15351","uniprot:Q17RN8","uniprot:Q5TBV5","uniprot:Q5TBV6","uniprot:Q8NHW9","uniprot:Q8TDY5","uniprot:Q8TDY6","uniprot:Q9NTK8"]}},{"id":2,"x":3150,"y":2590,"v":{"n":"ADA","r":"uniprot:P00813","alias":["uniprot:Q53F92","uniprot:Q6LA59"]}},{"id":3,"x":3570,"y":3430,"v":{"n":"AEN","r":"uniprot:C9J571","alias":["uniprot:Q8WTP8","uniprot:Q9BSA5","uniprot:Q9H9X7"]}},{"id":4,"x":3570,"y":3290,"v":{"n":"AFP","r":"uniprot:B2RBU3","alias":["uniprot:P02771"]}},{"id":5,"x":3850,"y":2590,"v":{"n":"BAK1","r":"uniprot:C0H5Y7","alias":["uniprot:Q16611","uniprot:Q6I9T6","uniprot:Q92533"]}},{"id":6,"x":3710,"y":3010,"v":{"n":"BAX","r":"uniprot:A8K4W1","alias":["uniprot:P55269","uniprot:Q07812","uniprot:Q07814","uniprot:Q07815","uniprot:Q8WZ49","uniprot:Q9NR76","uniprot:Q9NYG7","uniprot:Q9UCZ6","uniprot:Q9UCZ7","uniprot:Q9UQD6"]}},{"id":7,"x":3850,"y":3220,"v