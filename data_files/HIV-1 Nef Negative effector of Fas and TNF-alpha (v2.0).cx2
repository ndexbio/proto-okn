_Evidence\">99</a>)<li/>TNF binds RELA(<a href=\"https://db.indra.bio/statements/from_agents?subject=TNF&object=RELA&type=Complex&format=html&expand_all=true\" target=\"INDRA_Evidence\">94</a>)<li/>TNF inhibits RELA(<a href=\"https://db.indra.bio/statements/from_agents?subject=TNF&object=RELA&type=Inhibition&format=html&expand_all=true\" target=\"INDRA_Evidence\">75</a>)<li/>TNF dephosphorylates RELA(<a href=\"https://db.indra.bio/statements/from_agents?subject=TNF&object=RELA&type=Dephosphorylation&format=html&expand_all=true\" target=\"INDRA_Evidence\">42</a>)<li/>TNF acetylates RELA(<a href=\"https://db.indra.bio/statements/from_agents?subject=TNF&object=RELA&type=Acetylation&format=html&expand_all=true\" target=\"INDRA_Evidence\">33</a>)<li/>TNF decreases the amount of RELA(<a href=\"https://db.indra.bio/statements/from_agents?subject=TNF&object=RELA&type=DecreaseAmount&format=html&expand_all=true\" target=\"INDRA_Evidence\">17</a>)<li/>TNF ubiquitinates RELA(<a href=\"https://db.indra.bio/statements/from_agents?subject=TNF&object=RELA&type=Ubiquitination&format=html&expand_all=true\" target=\"INDRA_Evidence\">12</a>)<li/>TNF deacetylates RELA(<a href=\"https://db.indra.bio/statements/from_agents?subject=TNF&object=RELA&type=Deacetylation&format=html&expand_all=true\" target=\"INDRA_Evidence\">10</a>)<li/>TNF methylates RELA(<a href=\"https://db.indra.bio/statements/from_agents?subject=TNF&object=RELA&type=Methylation&format=html&expand_all=true\" target=\"INDRA_Evidence\">10</a>)<li/>TNF sumoylates RELA(<a href=\"https://db.indra.bio/statements/from_agents?subject=TNF&object=RELA&type=Sumoylation&format=html&expand_all=true\" target=\"INDRA_Evidence\">8</a>)<li/>RELA activates TNF(<a href=\"https://db.indra.bio/statements/from_agents?subject=RELA&object=TNF&type=Activation&format=html&expand_all=true\" target=\"INDRA_Evidence\">92</a>)<li/>RELA increases the amount of TNF(<a href=\"https://db.indra.bio/statements/from_agents?subject=RELA&object=TNF&type=IncreaseAmount&format=html&expand_all=true\" target=\"INDRA_Evidence\">45</a>)<li/>RELA inhibits TNF(<a href=\"https://db.indra.bio/statements/from_agents?subject=RELA&object=TNF&type=Inhibition&format=html&expand_all=true\" target=\"INDRA_Evidence\">30</a>)<li/>RELA phosphorylates TNF(<a href=\"https://db.indra.bio/statements/from_agents?subject=RELA&object=TNF&type=Phosphorylation&format=html&expand_all=true\" target=\"INDRA_Evidence\">20</a>)<li/>RELA decreases the amount of TNF(<a href=\"https://db.indra.bio/statements/from_agents?subject=RELA&object=TNF&type=DecreaseAmount&format=html&expand_all=true\" target=\"INDRA_Evidence\">15</a>)</ul>","__relationship_score":7.546974117516527,"i":"interacts with"}},{"id":356,"s":15,"t":28,"v":{"Relationships":"All Evidences (<a href=\"https://db.indra.bio/statements/from_agents?agent0=NFKBIA&agent1=TNF&format=html&expand_all=false\" target=\"INDRA_Evidence\">1505</a>)<ul><li/>TNF phosphorylates NFKBIA(<a href=\"https://db.indra.bio/statements/from_agents?subject=TNF&object=NFKBIA&type=Phosphorylation&format=html&expand_all=true\" target=\"INDRA_Evidence\">601</a>)<li/>TNF inhibits NFKBIA(<a href=\"https://db.indra.bio/statements/from_agents?subject=TNF&object=NFKBIA&type=Inhibition&format=html&expand_all=true\" target=\"INDRA_Evidence\">334</a>)<li/>TNF activates NFKBIA(<a href=\"https://db.indra.bio/statements/from_agents?subject=TNF&object=NFKBIA&type=Activation&format=html&expand_all=true\" target=\"INDRA_Evidence\">225</a>)<li/>TNF dephosphorylates NFKBIA(<a href=\"https://db.indra.bio/statements/from_agents?subject=TNF&object=NFKBIA&type=Dephosphorylation&format=html&expand_all=true\" target=\"INDRA_Evidence\">70</a>)<li/>TNF decreases the amount of NFKBIA(<a href=\"https://db.indra.bio/statements/from_agents?subject=TNF&object=NFKBIA&type=DecreaseAmount&format=html&expand_all=true\" target=\"INDRA_Evidence\">65</a>)<li/>TNF increases the amount of NFKBIA(<a href=\"https://db.indra.bio/statements/from_agents?subject=TNF&obj