[{"CXVersion":"2.0","hasFragments":false},{"metaData":[{"name":"networkAttributes","elementCount":1},{"name":"visualProperties","elementCount":1},{"name":"visualEditorProperties","elementCount":1},{"name":"attributeDeclarations","elementCount":1},{"name":"nodes","elementCount":17},{"name":"edges","elementCount":63}]},{"attributeDeclarations":[{"nodes":{"represents":{"a":"r","d":"string"},"name":{"a":"n","d":"string"},"alias":{"d":"list_of_string"},"type":{"d":"string"}},"networkAttributes":{"reference":{"d":"string"},"name":{"d":"string"},"description":{"d":"string"},"version":{"d":"string"},"@context":{"d":"string"}},"edges":{"Relationships":{"d":"string"},"__relationship_score":{"d":"double"},"interaction":{"a":"i","d":"string"},"__directed":{"d":"boolean"},"__reverse_directed":{"d":"boolean"},"__edge_source":{"d":"string"}}}]},{"networkAttributes":[{"name":"Arf6 downstream pathway (v2.0)","description":"<p>This is the updated version of an original NCI Pathway Interaction Database (PID) network.</p><p>The list of entities (genes, proteins, chemicals, etc) from the original network was used to query the <a href=\"https://www.indra.bio\" target=\"_blank\"><b>INDRA</b></a> database, retrieving high-quality relationships between entities. INDRA is a database that integrates information from multiple high-quality text mining engines, pathway databases, and small molecule resources. The INDRA-derived relationships are up-to-date and have links to detailed summaries of supporting literature evidence, including the specific supporting text.</p><p>While we have included only high-confidence relationships, text-mining complicated sentences can produce errors such as the reversal of up-regulation vs. down-regulation or the direction of an edge (i.e. B activates A instead of A activates B). Nevertheless, the entity recognition by the text miners is excellent and the text supporting a relationship almost always describes a genuine relationship between the entities.</p><p><b>Legend:</b><br/>BLUE: edges annotated by INDRA only.<br/>RED: edges annotated both by INDRA and PID.<br/>YELLOW: selected element.</p>","version":"2.0 (20220901)","reference":"<p>Pillich RT, Chen J, Churas C, Fong D, Gyori BM, Ideker T, Karis K, Liu SN, Ono K, Pico A, Pratt D.<br/><b>NDEx IQuery: a multi-method network gene set analysis leveraging the Network Data Exchange</b>.<br/> Bioinformatics. 2023 Mar 1;39(3):btad118.<br/><a href=\"https://doi/org/10.1093/bioinformatics/btad118\">doi: 10.1093/bioinformatics/btad118</a></p>","@context":"{\"chebi\": \"https://identifiers.org/chebi/CHEBI:\", \"uniprot\": \"https://identifiers.org/uniprot/\", \"cas\": \"https://identifiers.org/cas/\", \"hgnc.symbol\": \"https://identifiers.org/hgnc.symbol/\"}"}]},{"nodes":[{"id":0,"x":1190,"y":1470,"v":{"n":"ARF1","r":"uniprot:P10947","type":"protein","alias":["uniprot:P32889","uniprot:P84077"]}},{"id":1,"x":1400,"y":1400,"v":{"n":"ARF6","r":"uniprot:P26438","type":"protein","alias":["uniprot:P62330","uniprot:Q6FGZ2"]}},{"id":3,"x":1400,"y":1540,"v":{"n":"KALRN","r":"uniprot:A8MSI4","type":"protein","alias":["uniprot:C9JQ37","uniprot:O60229","uniprot:Q6ZN45","uniprot:Q8TBQ5","uniprot:Q9NSZ4","uniprot:Q9Y2A5"]}},{"id":4,"x":1330,"y":1820,"v":{"n":"MAPK1","r":"uniprot:A8CZ64","type":"protein","alias":["uniprot:P28482"]}},{"id":5,"x":1190,"y":1820,"v":{"n":"MAPK3","r":"uniprot:A8CZ58","type":"protein","alias":["uniprot:B0LPG3","uniprot:P27361","uniprot:Q8NHX1"]}},{"id":6,"x":1540,"y":1470,"v":{"n":"NME1","r":"uniprot:P15531","type":"protein","alias":["uniprot:Q6FGK3","uniprot:Q86XQ2","uniprot:Q9UDJ6"]}},{"id":7,"x":1120,"y":1260,"v":{"n":"PIP5K1A","r":"uniprot:A8K4Q0","type":"protein","alias":["uniprot:B4DIN0","uniprot:Q99754","uniprot:Q99755","uniprot:Q99756"]}},{"id":8,"x":1050,"y":1400,"v":{"n":"PLD1","r":"uniprot:Q13393","type":"protein"}},{"id":9,"x":980,"y":1610,"v":{"n":"PLD2","r":"uniprot:I3L2C9","type":"protein","alias":["uniprot:O14939","uniprot:O43540","uniprot:O43579","uni