[{"CXVersion":"2.0","hasFragments":false},{"metaData":[{"name":"networkAttributes","elementCount":1},{"name":"visualProperties","elementCount":1},{"name":"visualEditorProperties","elementCount":1},{"name":"attributeDeclarations","elementCount":1},{"name":"nodes","elementCount":26},{"name":"edges","elementCount":122}]},{"attributeDeclarations":[{"nodes":{"represents":{"a":"r","d":"string"},"name":{"a":"n","d":"string"},"alias":{"d":"list_of_string"},"type":{"d":"string"}},"networkAttributes":{"reference":{"d":"string"},"name":{"d":"string"},"description":{"d":"string"},"version":{"d":"string"},"@context":{"d":"string"}},"edges":{"Relationships":{"d":"string"},"__relationship_score":{"d":"double"},"interaction":{"a":"i","d":"string"},"__directed":{"v":true,"d":"boolean"},"__reverse_directed":{"v":true,"d":"boolean"},"__edge_source":{"v":"INDRA + NCI-PID","d":"string"}}}]},{"networkAttributes":[{"name":"Endogenous TLR signaling (v2.0)","description":"<p>This is the updated version of an original NCI Pathway Interaction Database (PID) network.</p><p>The list of entities (genes, proteins, chemicals, etc) from the original network was used to query the <a href=\"https://www.indra.bio\" target=\"_blank\"><b>INDRA</b></a> database, retrieving high-quality relationships between entities. INDRA is a database that integrates information from multiple high-quality text mining engines, pathway databases, and small molecule resources. The INDRA-derived relationships are up-to-date and have links to detailed summaries of supporting literature evidence, including the specific supporting text.</p><p>While we have included only high-confidence relationships, text-mining complicated sentences can produce errors such as the reversal of up-regulation vs. down-regulation or the direction of an edge (i.e. B activates A instead of A activates B). Nevertheless, the entity recognition by the text miners is excellent and the text supporting a relationship almost always describes a genuine relationship between the entities.</p><p><b>Legend:</b><br/>BLUE: edges annotated by INDRA only.<br/>RED: edges annotated both by INDRA and PID.<br/>YELLOW: selected element.</p>","version":"2.0 (20220901)","reference":"<p>Pillich RT, Chen J, Churas C, Fong D, Gyori BM, Ideker T, Karis K, Liu SN, Ono K, Pico A, Pratt D.<br/><b>NDEx IQuery: a multi-method network gene set analysis leveraging the Network Data Exchange</b>.<br/> Bioinformatics. 2023 Mar 1;39(3):btad118.<br/><a href=\"https://doi/org/10.1093/bioinformatics/btad118\">doi: 10.1093/bioinformatics/btad118</a></p>","@context":"{\"chebi\": \"https://identifiers.org/chebi/CHEBI:\", \"uniprot\": \"https://identifiers.org/uniprot/\", \"cas\": \"https://identifiers.org/cas/\", \"hgnc.symbol\": \"https://identifiers.org/hgnc.symbol/\"}"}]},{"nodes":[{"id":0,"x":1960,"y":2100,"v":{"n":"BGN","r":"uniprot:D3DWU3","type":"protein","alias":["uniprot:P13247","uniprot:P21810"]}},{"id":1,"x":1820,"y":1820,"v":{"n":"CD14","r":"uniprot:P08571","type":"protein","alias":["uniprot:Q53XT5","uniprot:Q96FR6","uniprot:Q96L99","uniprot:Q9UNS3"]}},{"id":2,"x":1890,"y":1680,"v":{"n":"LY96","r":"uniprot:B3Y6A5","type":"protein","alias":["uniprot:E5RJJ7","uniprot:Q9Y6Y9"]}},{"id":3,"x":2100,"y":2100,"v":{"n":"MYD88","r":"uniprot:B4DKH8","type":"protein","alias":["uniprot:B4DKU4","uniprot:B4DQ60","uniprot:B4DQ72","uniprot:J3KPU4","uniprot:J3KQ87","uniprot:J3KQJ6","uniprot:P78397","uniprot:Q53XS7","uniprot:Q99836"]}},{"id":4,"x":2380,"y":2170,"v":{"n":"TIRAP","r":"uniprot:B3KW65","type":"protein","alias":["uniprot:P58753","uniprot:Q56UH9","uniprot:Q56UI0","uniprot:Q8N5E5"]}},{"id":5,"x":1680,"y":2100,"v":{"n":"TLR1","r":"uniprot:D1CS39","type":"protein","alias":["uniprot:D1CS41","uniprot:O15452","uniprot:Q15399","uniprot:Q32MK3","uniprot:Q32MK4","uniprot:Q9UG90"]}},{"id":6,"x":1890,"y":2170,"v":{"n":"TLR2","r":"uniprot:B3Y612","type":"protein","alias":["uniprot:D1CS45","uniprot:D1CS48","uniprot:D1CS49","uniprot:O15454","uniprot:O60603","uni