[{"CXVersion":"2.0","hasFragments":false},{"metaData":[{"name":"networkAttributes","elementCount":1},{"name":"visualProperties","elementCount":1},{"name":"visualEditorProperties","elementCount":1},{"name":"attributeDeclarations","elementCount":1},{"name":"nodes","elementCount":7},{"name":"edges","elementCount":15}]},{"attributeDeclarations":[{"nodes":{"represents":{"a":"r","d":"string"},"name":{"a":"n","d":"string"},"alias":{"d":"list_of_string"},"type":{"d":"string"}},"networkAttributes":{"reference":{"d":"string"},"name":{"d":"string"},"description":{"d":"string"},"version":{"d":"string"},"@context":{"d":"string"}},"edges":{"Relationships":{"d":"string"},"__relationship_score":{"d":"double"},"interaction":{"a":"i","d":"string"},"__directed":{"d":"boolean"},"__reverse_directed":{"d":"boolean"},"__edge_source":{"d":"string"}}}]},{"networkAttributes":[{"name":"a4b7 Integrin signaling (v2.0)","description":"<p>This is the updated version of an original NCI Pathway Interaction Database (PID) network.</p><p>The list of entities (genes, proteins, chemicals, etc) from the original network was used to query the <a href=\"https://www.indra.bio\" target=\"_blank\"><b>INDRA</b></a> database, retrieving high-quality relationships between entities. INDRA is a database that integrates information from multiple high-quality text mining engines, pathway databases, and small molecule resources. The INDRA-derived relationships are up-to-date and have links to detailed summaries of supporting literature evidence, including the specific supporting text.</p><p>While we have included only high-confidence relationships, text-mining complicated sentences can produce errors such as the reversal of up-regulation vs. down-regulation or the direction of an edge (i.e. B activates A instead of A activates B). Nevertheless, the entity recognition by the text miners is excellent and the text supporting a relationship almost always describes a genuine relationship between the entities.</p><p><b>Legend:</b><br/>BLUE: edges annotated by INDRA only.<br/>RED: edges annotated both by INDRA and PID.<br/>YELLOW: selected element.</p>","version":"2.0 (20220901)","reference":"<p>Pillich RT, Chen J, Churas C, Fong D, Gyori BM, Ideker T, Karis K, Liu SN, Ono K, Pico A, Pratt D.<br/><b>NDEx IQuery: a multi-method network gene set analysis leveraging the Network Data Exchange</b>.<br/> Bioinformatics. 2023 Mar 1;39(3):btad118.<br/><a href=\"https://doi/org/10.1093/bioinformatics/btad118\">doi: 10.1093/bioinformatics/btad118</a></p>","@context":"{\"chebi\": \"https://identifiers.org/chebi/CHEBI:\", \"uniprot\": \"https://identifiers.org/uniprot/\", \"cas\": \"https://identifiers.org/cas/\", \"hgnc.symbol\": \"https://identifiers.org/hgnc.symbol/\"}"}]},{"nodes":[{"id":1,"x":1050,"y":1190,"v":{"n":"ITGA4","r":"uniprot:D3DPG4","type":"protein","alias":["uniprot:P13612","uniprot:Q7Z4L6"]}},{"id":2,"x":1050,"y":980,"v":{"n":"ITGB7","r":"uniprot:P26010","type":"protein","alias":["uniprot:Q9UCP7","uniprot:Q9UCS7"]}},{"id":3,"x":1120,"y":1050,"v":{"n":"MADCAM1","r":"uniprot:A5PKV4","type":"protein","alias":["uniprot:B2RPL9","uniprot:O60222","uniprot:O75867","uniprot:Q13477","uniprot:Q5UGI7"]}},{"id":4,"x":840,"y":980,"v":{"n":"RHOA","r":"uniprot:P06749","type":"protein","alias":["uniprot:P61586","uniprot:Q53HM4","uniprot:Q5U024","uniprot:Q9UDJ0","uniprot:Q9UEJ4"]}},{"id":5,"x":840,"y":1190,"v":{"n":"PTK2","r":"uniprot:B4E2N6","type":"protein","alias":["uniprot:F5H4S4","uniprot:J3QT16","uniprot:Q05397","uniprot:Q14291","uniprot:Q8IYN9","uniprot:Q9UD85"]}},{"id":7,"x":910,"y":1050,"v":{"n":"ITGB1","r":"uniprot:A8K6N2","type":"protein","alias":["uniprot:D3DRX9","uniprot:D3DRY3","uniprot:D3DRY4","uniprot:D3DRY5","uniprot:P05556","uniprot:P78466","uniprot:P78467","uniprot:Q13089","uniprot:Q13090","uniprot:Q13091","uniprot:Q13212","uniprot:Q14622","uniprot:Q14647","uniprot:Q29RW2","uniprot:Q7Z3V1","uniprot:Q8WUM6"]}},{"id":8,"x":980,"y":840,"v":{"n":"VCAM1","r":"uniprot:A8K6R7","type":"protein","alias":["uniprot:B4DKS4","uniprot:E9PDD1","uniprot:P19320","uniprot:Q6NUP8"]}}]},{"edges":[{"id":28,"s":4,"t":5,"v":{"Relationships":"All Evidences (<a href=\"https://db.indra.bio/statements/from_agents?agent0=RHOA&agent1=PTK2&format=html&expand_all=false\" target=\"INDRA_Evidence\">290</a>)<ul><li/>PTK2 activates RHOA(<a href=\"https://db.indra.bio/statements/from_agents?subject=PTK2&object=RHOA&type=Activation&format=html&expand_all=true\" target=\"INDRA_Evidence\">103</a>)<li/>PTK2 inhibits RHOA(<a href=\"https://db.indra.bio/statements/from_agents?subject=PTK2&object=RHOA&type=Inhibition&format=html&expand_all=true\" target=\"INDRA_Evidence\">69</a>)<li/>PTK2 binds RHOA(<a href=\"https://db.indra.bio/statements/from_agents?subject=PTK2&object=RHOA&type=Complex&format=html&expand_all=true\" target=\"INDRA_Evidence\">14</a>)<li/>PTK2 phosphorylates RHOA(<a href=\"https://db.indra.bio/statements/from_agents?subject=PTK2&object=RHOA&type=Phosphorylation&format=html&expand_all=true\" target=\"INDRA_Evidence\">12</a>)<li/>PTK2 is a GEF for RHOA(<a href=\"https://db.indra.bio/statements/from_agents?subject=PTK2&object=RHOA&type=Gef&format=html&expand_all=true\" target=\"INDRA_Evidence\">4</a>)<li/>RHOA phosphorylates PTK2(<a href=\"https://db.indra.bio/statements/from_agents?subject=RHOA&object=PTK2&type=Phosphorylation&format=html&expand_all=true\" target=\"INDRA_Evidence\">40</a>)<li/>RHOA activates PTK2(<a href=\"https://db.indra.bio/statements/from_agents?subject=RHOA&object=PTK2&type=Activation&format=html&expand_all=true\" target=\"INDRA_Evidence\">36</a>)<li/>RHOA dephosphorylates PTK2(<a href=\"https://db.indra.bio/statements/from_agents?subject=RHOA&object=PTK2&type=Dephosphorylation&format=html&expand_all=true\" target=\"INDRA_Evidence\">6</a>)<li/>RHOA inhibits PTK2(<a href=\"https://db.indra.bio/statements/from_agents?subject=RHOA&object=PTK2&type=Inhibition&format=html&expand_all=true\" target=\"INDRA_Evidence\">6</a>)</ul>","__edge_source":"INDRA","__relationship_score":5.66988092298052,"__directed":true,"__reverse_directed":true,"i":"interacts with"}},{"id":29,"s":5,"t":7,"v":{"Relationships":"All Evidences (<a href=\"https://db.indra.bio/statements/from_agents?agent0=ITGB1&agent1=PTK2&format=html&expand_all=false\" target=\"INDRA_Evidence\">64</a>)<ul><li/>ITGB1 activates PTK2(<a href=\"https://db.indra.bio/statements/from_agents?subject=ITGB1&object=PTK2&type=Activation&format=html&expand_all=true\" target=\"INDRA_Evidence\">31</a>)<li/>ITGB1 phosphorylates PTK2(<a href=\"https://db.indra.bio/statements/from_agents?subject=ITGB1&object=PTK2&type=Phosphorylation&format=html&expand_all=true\" target=\"INDRA_Evidence\">5</a>)<li/>ITGB1 inhibits PTK2(<a href=\"https://db.indra.bio/statements/from_agents?subject=ITGB1&object=PTK2&type=Inhibition&format=html&expand_all=true\" target=\"INDRA_Evidence\">5</a>)<li/>ITGB1 increases the amount of PTK2(<a href=\"https://db.indra.bio/statements/from_agents?subject=ITGB1&object=PTK2&type=IncreaseAmount&format=html&expand_all=true\" target=\"INDRA_Evidence\">2</a>)<li/>ITGB1 dephosphorylates PTK2(<a href=\"https://db.indra.bio/statements/from_agents?subject=ITGB1&object=PTK2&type=Dephosphorylation&format=html&expand_all=true\" target=\"INDRA_Evidence\">2</a>)<li/>PTK2 binds ITGB1(<a href=\"https://db.indra.bio/statements/from_agents?subject=PTK2&object=ITGB1&type=Complex&format=html&expand_all=true\" target=\"INDRA_Evidence\">16</a>)<li/>PTK2 activates ITGB1(<a href=\"https://db.indra.bio/statements/from_agents?subject=PTK2&object=ITGB1&type=Activation&format=html&expand_all=true\" target=\"INDRA_Evidence\">3</a>)</ul>","__edge_source":"INDRA","__relationship_score":4.1588830833596715,"__directed":true,"__reverse_directed":true,"i":"interacts with"}},{"id":31,"s":5,"t":8,"v":{"Relationships":"All Evidences (<a href=\"https://db.indra.bio/statements/from_agents?agent0=VCAM1&agent1=PTK2&format=html&expand_all=false\" target=\"INDRA_Evidence\">33</a>)<ul><li/>PTK2 incr