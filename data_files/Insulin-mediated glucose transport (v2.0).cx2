bject=INS&object=SLC2A4&type=Activation&format=html&expand_all=true\" target=\"INDRA_Evidence\">1807</a>)<li/>INS increases the amount of SLC2A4(<a href=\"https://db.indra.bio/statements/from_agents?subject=INS&object=SLC2A4&type=IncreaseAmount&format=html&expand_all=true\" target=\"INDRA_Evidence\">252</a>)<li/>INS inhibits SLC2A4(<a href=\"https://db.indra.bio/statements/from_agents?subject=INS&object=SLC2A4&type=Inhibition&format=html&expand_all=true\" target=\"INDRA_Evidence\">227</a>)<li/>INS phosphorylates SLC2A4(<a href=\"https://db.indra.bio/statements/from_agents?subject=INS&object=SLC2A4&type=Phosphorylation&format=html&expand_all=true\" target=\"INDRA_Evidence\">53</a>)<li/>INS decreases the amount of SLC2A4(<a href=\"https://db.indra.bio/statements/from_agents?subject=INS&object=SLC2A4&type=DecreaseAmount&format=html&expand_all=true\" target=\"INDRA_Evidence\">40</a>)<li/>INS dephosphorylates SLC2A4(<a href=\"https://db.indra.bio/statements/from_agents?subject=INS&object=SLC2A4&type=Dephosphorylation&format=html&expand_all=true\" target=\"INDRA_Evidence\">21</a>)<li/>SLC2A4 activates INS(<a href=\"https://db.indra.bio/statements/from_agents?subject=SLC2A4&object=INS&type=Activation&format=html&expand_all=true\" target=\"INDRA_Evidence\">156</a>)<li/>SLC2A4 binds INS(<a href=\"https://db.indra.bio/statements/from_agents?subject=SLC2A4&object=INS&type=Complex&format=html&expand_all=true\" target=\"INDRA_Evidence\">68</a>)<li/>SLC2A4 inhibits INS(<a href=\"https://db.indra.bio/statements/from_agents?subject=SLC2A4&object=INS&type=Inhibition&format=html&expand_all=true\" target=\"INDRA_Evidence\">59</a>)<li/>SLC2A4 decreases the amount of INS(<a href=\"https://db.indra.bio/statements/from_agents?subject=SLC2A4&object=INS&type=DecreaseAmount&format=html&expand_all=true\" target=\"INDRA_Evidence\">5</a>)<li/>SLC2A4 phosphorylates INS(<a href=\"https://db.indra.bio/statements/from_agents?subject=SLC2A4&object=INS&type=Phosphorylation&format=html&expand_all=true