[{"CXVersion":"2.0","hasFragments":false},{"metaData":[{"name":"networkAttributes","elementCount":1},{"name":"visualProperties","elementCount":1},{"name":"visualEditorProperties","elementCount":1},{"name":"attributeDeclarations","elementCount":1},{"name":"nodes","elementCount":4},{"name":"edges","elementCount":3}]},{"attributeDeclarations":[{"nodes":{"represents":{"a":"r","d":"string"},"name":{"a":"n","d":"string"},"alias":{"d":"list_of_string"},"type":{"d":"string"}},"networkAttributes":{"reference":{"d":"string"},"name":{"d":"string"},"description":{"d":"string"},"version":{"d":"string"},"@context":{"d":"string"}},"edges":{"Relationships":{"d":"string"},"__relationship_score":{"d":"double"},"interaction":{"a":"i","d":"string"},"__directed":{"d":"boolean"},"__reverse_directed":{"d":"boolean"},"__edge_source":{"d":"string"}}}]},{"networkAttributes":[{"name":"Class IB PI3K non-lipid kinase events (v2.0)","description":"<p>This is the updated version of an original NCI Pathway Interaction Database (PID) network.</p><p>The list of entities (genes, proteins, chemicals, etc) from the original network was used to query the <a href=\"https://www.indra.bio\" target=\"_blank\"><b>INDRA</b></a> database, retrieving high-quality relationships between entities. INDRA is a database that integrates information from multiple high-quality text mining engines, pathway databases, and small molecule resources. The INDRA-derived relationships are up-to-date and have links to detailed summaries of supporting literature evidence, including the specific supporting text.</p><p>While we have included only high-confidence relationships, text-mining complicated sentences can produce errors such as the reversal of up-regulation vs. down-regulation or the direction of an edge (i.e. B activates A instead of A activates B). Nevertheless, the entity recognition by the text miners is excellent and the text supporting a relationship almost always describes a genuine relationship between the entities.</p><p><b>Legend:</b><br/>BLUE: edges annotated by INDRA only.<br/>RED: edges annotated both by INDRA and PID.<br/>YELLOW: selected element.</p>","version":"2.0 (20220901)","reference":"<p>Pillich RT, Chen J, Churas C, Fong D, Gyori BM, Ideker T, Karis K, Liu SN, Ono K, Pico A, Pratt D.<br/><b>NDEx IQuery: a multi-method network gene set analysis leveraging the Network Data Exchange</b>.<br/> Bioinformatics. 2023 Mar 1;39(3):btad118.<br/><a href=\"https://doi/org/10.1093/bioinformatics/btad118\">doi: 10.1093/bioinformatics/btad118</a></p>","@context":"{\"chebi\": \"https://identifiers.org/chebi/CHEBI:\", \"uniprot\": \"https://identifiers.org/uniprot/\", \"cas\": \"https://identifiers.org/cas/\", \"hgnc.symbol\": \"https://identifiers.org/hgnc.symbol/\"}"}]},{"nodes":[{"id":0,"x":840,"y":770,"v":{"n":"MAP2K1","r":"uniprot:Q02750","type":"protein"}},{"id":1,"x":910,"y":840,"v":{"n":"MAPK1","r":"uniprot:A8CZ64","type":"protein","alias":["uniprot:P28482"]}},{"id":2,"x":770,"y":700,"v":{"n":"PIK3CG","r":"uniprot:A4D0Q6","type":"protein","alias":["uniprot:P48736","uniprot:Q8IV23","uniprot:Q9BZC8"]}},{"id":4,"x":700,"y":630,"v":{"n":"PDE3B","r":"uniprot:B7ZM37","type":"protein","alias":["uniprot:O00639","uniprot:Q13370","uniprot:Q14408","uniprot:Q6SEI4"]}}]},{"edges":[{"id":18,"s":0,"t":1,"v":{"Relationships":"All Evidences (<a href=\"https://db.indra.bio/statements/from_agents?agent0=MAPK1&agent1=MAP2K1&format=html&expand_all=false\" target=\"INDRA_Evidence\">511</a>)<ul><li/>MAP2K1 phosphorylates MAPK1(<a href=\"https://db.indra.bio/statements/from_agents?subject=MAP2K1&object=MAPK1&type=Phosphorylation&format=html&expand_all=true\" target=\"INDRA_Evidence\">233</a>)<li/>MAP2K1 activates MAPK1(<a href=\"https://db.indra.bio/statements/from_agents?subject=MAP2K1&object=MAPK1&type=Activation&format=html&expand_all=true\" target=\"INDRA_Evidence\">152</a>)<li/>MAP2K1 binds MAPK1(<a href=\"https://db.indra.bio/statements/from_agents?subject=MAP2K1&object=MAPK1&type=Complex&format=html&expand_all=true\" target=\"INDRA_Evidence\">82</a>)<li/>MAP2K1 inhibits MAPK1(<a href=\"https://db.indra.bio/statements/from_agents?subject=MAP2K1&object=MAPK1&type=Inhibition&format=html&expand_all=true\" target=\"INDRA_Evidence\">8</a>)<li/>MAPK1 phosphorylates MAP2K1(<a href=\"https://db.indra.bio/statements/from_agents?subject=MAPK1&object=MAP2K1&type=Phosphorylation&format=html&expand_all=true\" target=\"INDRA_Evidence\">27</a>)<li/>MAPK1 activates MAP2K1(<a href=\"https://db.indra.bio/statements/from_agents?subject=MAPK1&object=MAP2K1&type=Activation&format=html&expand_all=true\" target=\"INDRA_Evidence\">5</a>)<li/>MAPK1 inhibits MAP2K1(<a href=\"https://db.indra.bio/statements/from_agents?subject=MAPK1&object=MAP2K1&type=Inhibition&format=html&expand_all=true\" target=\"INDRA_Evidence\">4</a>)</ul>","__edge_source":"INDRA + NCI-PID","__relationship_score":6.236369590203704,"__directed":true,"__reverse_directed":true,"i":"interacts with"}},{"id":19,"s":2,"t":4,"v":{"Relationships":"All Evidences (<a href=\"https://db.indra.bio/statements/from_agents?agent0=PIK3CG&agent1=PDE3B&format=html&expand_all=false\" target=\"INDRA_Evidence\">30</a>)<ul><li/>PIK3CG binds PDE3B(<a href=\"https://db.indra.bio/statements/from_agents?subject=PIK3CG&object=PDE3B&type=Complex&format=html&expand_all=true\" target=\"INDRA_Evidence\">21</a>)<li/>PIK3CG activates PDE3B(<a href=\"https://db.indra.bio/statements/from_agents?subject=PIK3CG&object=PDE3B&type=Activation&format=html&expand_all=true\" target=\"INDRA_Evidence\">9</a>)</ul>","__edge_source":"INDRA + NCI-PID","__relationship_score":3.4011973816621555,"__directed":true,"__reverse_directed":false,"i":"interacts with"}},{"id":20,"s":0,"t":2,"v":{"Relationships":"All Evidences (<a href=\"https://db.indra.bio/statements/from_agents?agent0=PIK3CG&agent1=MAP2K1&format=html&expand_all=false\" target=\"INDRA_Evidence\">2</a>)<ul><li/>PIK3CG activates MAP2K1(<a href=\"https://db.indra.bio/statements/from_agents?subject=