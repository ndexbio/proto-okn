","r":"uniprot:B3KT19","type":"protein","alias":["uniprot:D3DWA0","uniprot:E7EX19","uniprot:P27986","uniprot:Q15747","uniprot:Q4VBZ7","uniprot:Q53EM6","uniprot:Q8IXA2","uniprot:Q8N1C5"]}},{"id":38,"x":2240,"y":2310,"v":{"n":"PTPN11","r":"uniprot:A8K1D9","type":"protein","alias":["uniprot:Q06124","uniprot:Q96HD7"]}},{"id":40,"x":2450,"y":2240,"v":{"n":"PLCG2","r":"uniprot:D3DUL3","type":"protein","alias":["uniprot:P16885","uniprot:Q3ZTS2","uniprot:Q59H45","uniprot:Q969T5"]}}]},{"edges":[{"id":289,"s":3,"t":8,"v":{"Relationships":"All Evidences (<a href=\"https://db.indra.bio/statements/from_agents?agent0=BCL2&agent1=BCL2L1&format=html&expand_all=false\" target=\"INDRA_Evidence\">1379</a>)<ul><li/>BCL2L1 binds BCL2(<a href=\"https://db.indra.bio/statements/from_agents?subject=BCL2L1&object=BCL2&type=Complex&format=html&expand_all=true\" target=\"INDRA_Evidence\">1150</a>)<li/>BCL2L1 inhibits BCL2(<a href=\"https://db.indra.bio/statements/from_agents?subject=BCL2L1&object=BCL2&type=Inhibition&format=html&expand_all=true\" target=\"INDRA_Evidence\">55</a>)<li/>BCL2L1 activates BCL2(<a href=\"https://db.indra.bio/statements/from_agents?subject=BCL2L1&object=BCL2&type=Activation&format=html&expand_all=true\" target=\"INDRA_Evidence\">31</a>)<li/>BCL2L1 increases the amount of BCL2(<a href=\"https://db.indra.bio/statements/from_agents?subject=BCL2L1&object=BCL2&type=IncreaseAmount&format=html&expand_all=true\" target=\"INDRA_Evidence\">8</a>)<li/>BCL2L1 decreases the amount of BCL2(<a href=\"https://db.indra.bio/statements/from_agents?subject=BCL2L1&object=BCL2&type=DecreaseAmount&format=html&expand_all=true\" target=\"INDRA_Evidence\">4</a>)<li/>BCL2L1 phosphorylates BCL2(<a href=\"https://db.indra.bio/statements/from_agents?subject=BCL2L1&object=BCL2&type=Phosphorylation&format=html&expand_all=true\" target=\"INDRA_Evidence\">2</a>)<li/>BCL2 inhibits BCL2L1(<a href=\"https://db.indra.bio/statements/from_agents?subject=BCL2&object=BCL2L1&type=Inhibition&format=html&expand