ct=GNAO1&object=GNAI1&type=Complex&format=html&expand_all=true\" target=\"INDRA_Evidence\">5</a>)<li/>GNAO1 binds GNAI3(<a href=\"https://db.indra.bio/statements/from_agents?subject=GNAO1&object=GNAI3&type=Complex&format=html&expand_all=true\" target=\"INDRA_Evidence\">2</a>)<li/>GNAO1 binds GNAI2(<a href=\"https://db.indra.bio/statements/from_agents?subject=GNAO1&object=GNAI2&type=Complex&format=html&expand_all=true\" target=\"INDRA_Evidence\">2</a>)<li/>GNAO1 is a GAP for GNAI3(<a href=\"https://db.indra.bio/statements/from_agents?subject=GNAO1&object=GNAI3&type=Gap&format=html&expand_all=true\" target=\"INDRA_Evidence\">1</a>)<li/>GNAO1 is a GAP for GNAI1(<a href=\"https://db.indra.bio/statements/from_agents?subject=GNAO1&object=GNAI1&type=Gap&format=html&expand_all=true\" target=\"INDRA_Evidence\">1</a>)<li/>GNAO1 is a GAP for GNAZ(<a href=\"https://db.indra.bio/statements/from_agents?subject=GNAO1&object=GNAZ&type=Gap&format=html&expand_all=true\" target=\"INDRA_Evidence\">1</a>)<li/>GNAO1 is a GAP for GNAI2(<a href=\"https://db.indra.bio/statements/from_agents?subject=GNAO1&object=GNAI2&type=Gap&format=html&expand_all=true\" target=\"INDRA_Evidence\">1</a>)<li/>GNAI1 binds GNAI3(<a href=\"https://db.indra.bio/statements/from_agents?subject=GNAI1&object=GNAI3&type=Complex&format=html&expand_all=true\" target=\"INDRA_Evidence\">5</a>)<li/>GNAI1 activates GNAI2(<a href=\"https://db.indra.bio/statements/from_agents?subject=GNAI1&object=GNAI2&type=Activation&format=html&expand_all=true\" target=\"INDRA_Evidence\">2</a>)<li/>GNAI1 is a GAP for GNAI2(<a href=\"https://db.indra.bio/statements/from_agents?subject=GNAI1&object=GNAI2&type=Gap&format=html&expand_all=true\" target=\"INDRA_Evidence\">2</a>)<li/>GNAI1 is a GAP for GNAI3(<a href=\"https://db.indra.bio/statements/from_agents?subject=GNAI1&object=GNAI3&type=Gap&format=html&expand_all=true\" target=\"INDRA_Evidence\">2</a>)<li/>GNAI1 binds GNAI2(<a href=\"https://db.indra.bio/statements/from_agents?subject=GNAI1&object=GNAI2&type=Complex&format=html&expand_all=true\" target=\"INDRA_Evidence\">1</a>)<li/>GNAI1 is a GAP for GNAO1(<a href=\"https://db.indra.bio/statements/from_agents?subject=GNAI1&object=GNAO1&type=Gap&format=html&expand_all=true\" target=\"INDRA_Evidence\">1</a>)<li/>GNAI1 is a GAP for GNAZ(<a href=\"https://db.indra.bio/statements/from_agents?subject=GNAI1&object=GNAZ&type=Gap&format=html&expand_all=true\" target=\"INDRA_Evidence\">1</a>)<li/>GNAI2 binds GNAI3(<a href=\"https://db.indra.bio/statements/from_agents?subject=GNAI2&object=GNAI3&type=Complex&format=html&expand_all=true\" target=\"INDRA_Evidence\">3</a>)<li/>GNAI2 is a GAP for GNAI3(<a href=\"https://db.indra.bio/statements/from_agents?subject=GNAI2&object=GNAI3&type=Gap&format=html&expand_all=true\" target=\"INDRA_Evidence\">2</a>)<li/>GNAI2 activates GNAI1(<a href=\"https://db.indra.bio/statements/from_agents?subject=GNAI2&object=GNAI1&type=Activation&format=html&expand_all=true\" target=\"INDRA_Evidence\">2</a>)<li/>GNAI2 is a GAP for GNAI1(<a href=\"https://db.indra.bio/statements/from_agents?subject=GNAI2&object=GNAI1&type=Gap&format=html&expand_all=true\" target=\"INDRA_Evidence\">2</a>)<li/>GNAI2 is a GAP for GNAO1(<a href=\"https://db.indra.bio/statements/from_agents?subject=GNAI2&object=GNAO1&type=Gap&format=html&expand_all=true\" target=\"INDRA_Evidence\">1</a>)<li/>GNAI2 is a GAP for GNAZ(<a href=\"https://db.indra.bio/statements/from_agents?subject=GNAI2&object=GNAZ&type=Gap&format=html&expand_all=true\" target=\"INDRA_Evidence\">1</a>)<li/>GNAI3 is a GAP for GNAI2(<a href=\"https://db.indra.bio/statements/from_agents?subject=GNAI3&object=GNAI2&type=Gap&format=html&expand_all=true\" target=\"INDRA_Evidence\">2</a>)<li/>GNAI3 activates GNAI2(<a href=\"https://db.indra.bio/statements/from_agents?subject=GNAI3&object=GNAI2&type=Activation&format=html&expand_all=true\" target=\"INDRA_Evidence\">2</a>)<li/>GNAI3 is a GAP for GNAI1(<a href=\"https://db.indra.bio/statements/from_agents?subjec