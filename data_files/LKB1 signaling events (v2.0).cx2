hosphorylation&format=html&expand_all=true\" target=\"INDRA_Evidence\">2</a>)<li/>MTOR activates TP53(<a href=\"https://db.indra.bio/statements/from_agents?subject=MTOR&object=TP53&type=Activation&format=html&expand_all=true\" target=\"INDRA_Evidence\">46</a>)<li/>MTOR phosphorylates TP53(<a href=\"https://db.indra.bio/statements/from_agents?subject=MTOR&object=TP53&type=Phosphorylation&format=html&expand_all=true\" target=\"INDRA_Evidence\">43</a>)<li/>MTOR inhibits TP53(<a href=\"https://db.indra.bio/statements/from_agents?subject=MTOR&object=TP53&type=Inhibition&format=html&expand_all=true\" target=\"INDRA_Evidence\">29</a>)<li/>MTOR decreases the amount of TP53(<a href=\"https://db.indra.bio/statements/from_agents?subject=MTOR&object=TP53&type=DecreaseAmount&format=html&expand_all=true\" target=\"INDRA_Evidence\">5</a>)<li/>MTOR increases the amount of TP53(<a href=\"https://db.indra.bio/statements/from_agents?subject=MTOR&object=TP53&type=IncreaseAmount&format=html&expand_all=true\" target=\"INDRA_Evidence\">2</a>)<li/>MTOR dephosphorylates TP53(<a href=\"https://db.indra.bio/statements/from_agents?subject=MTOR&object=TP53&type=Dephosphorylation&format=html&expand_all=true\" target=\"INDRA_Evidence\">2</a>)<li/>MTOR ubiquitinates TP53(<a href=\"https://db.indra.bio/statements/from_agents?subject=MTOR&object=TP53&type=Ubiquitination&format=html&expand_all=true\" target=\"INDRA_Evidence\">2</a>)</ul>","__relationship_score":6.349138991379798,"__directed":true,"__reverse_directed":true,"i":"interacts with"}},{"id":339,"s":37,"t":38,"v":{"Relationships":"All Evidences (<a href=\"https://db.indra.bio/statements/from_agents?agent0=TSC2&agent1=TP53&format=html&expand_all=false\" target=\"INDRA_Evidence\">42</a>)<ul><li/>TP53 activates TSC2(<a href=\"https://db.indra.bio/statements/from_agents?subject=TP53&object=TSC2&type=Activation&format=html&expand_all=true\" target=\"INDRA_Evidence\">15</a>)<li/>TP53 binds TSC2(<a href=\"https://db.indra.bio/statements/from_agents