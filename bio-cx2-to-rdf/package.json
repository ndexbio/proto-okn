{
  "name": "bio-cx2-to-rdf",
  "version": "1.0.0",
  "description": "CLI tool to convert NCI-PID CX2 networks to RDF Turtle format",
  "type": "module",
  "main": "dist/cli/index.js",
  "bin": {
    "bio-cx2-to-rdf": "./dist/cli/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/cli/index.js",
    "dev": "tsc --watch",
    "refresh:bioregistry": "node scripts/refresh-bioregistry.js"
  },
  "keywords": [
    "cx2",
    "rdf",
    "turtle",
    "nci-pid",
    "bioinformatics"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "commander": "^12.0.0",
    "n3": "^1.17.2"
  },
  "devDependencies": {
    "@types/n3": "^1.16.4",
    "@types/node": "^20.10.0",
    "linkedom": "^0.16.11",
    "typescript": "^5.3.3"
  }
}
